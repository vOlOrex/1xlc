local function activeParticles() return #ParticleLayer:GetChildren() end

local function emitSpark(col, x0, y0, vx, vy, dur)
	if activeParticles() > 42 then return end
	local sz = math.random(3, 6)
	local sp = box({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(sz, sz),
		Position = UDim2.fromOffset(x0 or math.random(24, STAGE_W - 24), y0 or math.random(110, STAGE_H - 10)),
		BackgroundColor3 = (math.random() < 0.3) and P.white or col,
		BackgroundTransparency = 0.05,
		ZIndex = 5,
		Parent = ParticleLayer,
	}, { pill() })
	anim(sp, dur or math.random(12, 20) / 10, {
		Position = sp.Position + UDim2.fromOffset(vx or math.random(-14, 14), vy or -math.random(50, 100)),
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(1, 1),
	}, Enum.EasingStyle.Sine).Completed:Connect(function() sp:Destroy() end)
end

local function emitTwinkle(col)
	if activeParticles() > 42 then return end
	local tw = box({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(12, 12),
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(math.random(12, STAGE_W - 12), math.random(12, STAGE_H - 30)),
		Rotation = math.random(0, 45),
		ZIndex = 5,
		Parent = ParticleLayer,
	})
	local sc = make("UIScale", { Scale = 0.2, Parent = tw })
	local bars = {
		box({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(1, 0, 0, 2),
			BackgroundColor3 = col, BackgroundTransparency = 1, Parent = tw }, { pill() }),
		box({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0, 2, 1, 0),
			BackgroundColor3 = P.white, BackgroundTransparency = 1, Parent = tw }, { pill() }),
	}
	anim(sc, 0.35, { Scale = 1.2 }, Enum.EasingStyle.Back)
	for _, b in ipairs(bars) do anim(b, 0.35, { BackgroundTransparency = 0 }) end
	task.delay(0.4, function()
		if not tw.Parent then return end
		anim(sc, 0.5, { Scale = 0 })
		for _, b in ipairs(bars) do anim(b, 0.5, { BackgroundTransparency = 1 }) end
		task.delay(0.55, function() tw:Destroy() end)
	end)
