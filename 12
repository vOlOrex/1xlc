local function getPrimeTool(fruitName)
	local candidates = { fruitName .. " Fruit", fruitName }
	if fruitName:find("%(") then
		local baseName = fruitName:match("^(.-)%s*%(") or fruitName
		table.insert(candidates, baseName .. "-" .. baseName .. " Fruit")
		table.insert(candidates, baseName .. " Fruit")
		table.insert(candidates, baseName)
	end
	for _, name in ipairs(candidates) do
		local tool = LocalPlayer.Backpack and LocalPlayer.Backpack:FindFirstChild(name)
		if tool and tool:IsA("Tool") and not tool:GetAttribute("X10Fake") then return tool end
		local charTool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild(name)
		if charTool and charTool:IsA("Tool") and not charTool:GetAttribute("X10Fake") then return charTool end
	end
	return nil
end

