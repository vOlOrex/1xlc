task.spawn(function()
	if not commF then return end
	local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
	local inv = getInventory()
	local mythItems = {}

	for _, item in pairs(inv) do
		if item.Type == "Blox Fruit" and (item.Rarity or 0) == 4 then
			table.insert(mythItems, item)
		end
	end

	for _, item in ipairs(mythItems) do
		local name = item.Name or (item.DisplayName .. "-" .. item.DisplayName)
		local displayName = item.DisplayName or name
		if replicatedFruits:FindFirstChild(name) then
			loadedModelFlags[name] = true
		else
			pcall(function() commF:InvokeServer("LoadFruit", name) end)
			local toolFound = nil
			local now = tick()
			while tick() - now < 3 do
				local found = LocalPlayer.Backpack:FindFirstChild(displayName .. " Fruit") or LocalPlayer.Backpack:FindFirstChild(item.Name .. " Fruit")
				if found then toolFound = found; break else task.wait(0.1) end
			end

			if toolFound then
				local clone = toolFound:Clone()
				clone.Name = name
				clone.Parent = replicatedFruits
				loadedModelFlags[name] = true
				pcall(function()
					local humanoid = character:FindFirstChildWhichIsA("Humanoid")
					if humanoid then
						humanoid:EquipTool(toolFound)
						task.wait(1)
						local charModel = workspace.Characters:FindFirstChild(LocalPlayer.Name)
						if charModel then
							charModel = charModel:FindFirstChild(displayName .. " Fruit") or charModel:FindFirstChild(item.Name .. " Fruit")
						end
						if charModel then
							local clone2 = charModel:Clone()
							clone2.Name = name
							local fruit = clone2:FindFirstChild("Fruit")
							local rootPart = fruit and fruit:FindFirstChild("RootPart")
							if rootPart then
								for _, descendant in ipairs(fruit:GetDescendants()) do
									if descendant:IsA("BasePart") and descendant ~= rootPart then
										if not descendant:FindFirstChildWhichIsA("WeldConstraint") then
											local weldConstraint = Instance.new("WeldConstraint")
											weldConstraint.Part0 = rootPart
											weldConstraint.Part1 = descendant
											weldConstraint.Parent = descendant
										end
									end
								end
							end
							cachedFruitModels[name] = clone2
							commF:InvokeServer("StoreFruit", name, charModel)
						end
					end
				end)
				task.wait(0.8)
			end
		end
	end

	for i = #ownedMythPool, 1, -1 do ownedMythPool[i] = nil end
	for _, mFruit in ipairs(mythicalFruits) do
		if loadedModelFlags[mFruit.StorageName] then
			table.insert(ownedMythPool, mFruit)
		end
	end
end)

