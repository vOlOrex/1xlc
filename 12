local clockAcc, sparkAcc, twinkleAcc, arcAcc, glintAcc, pulseAcc = 0, 0, 0, 0, 0, 0
on(RunService.Heartbeat, function(dt)
	if not alive then return end
	clockAcc += dt
	panelBorderGrad.Rotation = (clockAcc * 55) % 360
	pillGrad.Rotation = (clockAcc * 75) % 360
	local wave = math.sin(clockAcc * 1.4)
	subBrandGrad.Offset = Vector2.new(wave * 0.35, 0)
	if app.enabled then actionGrad.Offset = Vector2.new(math.sin(clockAcc * 1.2) * 0.25, 0) end
	logoFruit.body.Rotation = math.sin(clockAcc * 2) * 8
	pillFruit.body.Rotation = math.sin(clockAcc * 2.5) * 10

	for _, L in ipairs(waveLayers) do
		local span = #L.dots * L.gap
		for i, d in ipairs(L.dots) do
			local x = ((i - 1) * L.gap + clockAcc * L.sp) % span - L.gap
			local edge = math.clamp(math.min(x, STAGE_W - x) / 26, 0, 1)
			d.Position = UDim2.fromOffset(x, L.y + math.sin(clockAcc * 2.2 + i * 0.9 + L.ph) * 2.5)
			d.BackgroundTransparency = 1 - (1 - L.tr) * edge
		end
	end

	if app.status == "Scanning" then
		RadarBeam.Rotation = (clockAcc * 300) % 360
		LaserBar.Position = UDim2.new(0, 0, (clockAcc * 0.85) % 1.1, 0)
		LoadSpinner.Rotation = (clockAcc * 540) % 360
		StateDot.BackgroundTransparency = 0.5 + 0.5 * math.sin(clockAcc * 10)
	end

	local col = app.fxColor
	if col then
		local s = math.sin(clockAcc * 3)
		InnerAura.BackgroundTransparency = 0.8 + 0.08 * s
		innerAuraStroke.Transparency = 0.15 + 0.25 * s
		innerAuraScale.Scale = 1 + 0.05 * s
		outerAuraScale.Scale = 1 + 0.08 * math.sin(clockAcc * 2)
		stageBorder.Transparency = 0.15 + 0.2 * s
		heroEmblem.body.Rotation = math.sin(clockAcc * 1.6) * 6

		if app.beamsOn then
			local lvl = app.fxTier
			local baseT = (lvl == 1 and 0.75) or (lvl == 2 and 0.5) or 0.35
			for i, b in ipairs(lightBeams) do
				local a = math.rad(i * (360 / #lightBeams) + clockAcc * (lvl == 3 and 40 or 25))
				local rad = 46 + math.sin(clockAcc * 3 + i) * 3
				b.Position = UDim2.fromOffset(CENTER_X + math.sin(a) * rad, CENTER_Y - math.cos(a) * rad)
				b.Rotation = math.deg(a)
				b.BackgroundTransparency = baseT + 0.15 * math.sin(clockAcc * 4 + i)
			end
		end

		local lvl = app.fxTier
		if lvl >= 2 then
			sparkAcc += dt
			if sparkAcc > (lvl == 3 and 0.08 or 0.14) then
				sparkAcc = 0
				emitSpark((lvl == 3 and math.random() < 0.35) and P.amber or col)
			end
			pulseAcc += dt
			if pulseAcc > (lvl == 3 and 1.4 or 2.2) then pulseAcc = 0; emitPulse(col) end
		end
		if lvl >= 1 then
			twinkleAcc += dt
			if twinkleAcc > (lvl == 3 and 0.3 or lvl == 2 and 0.5 or 1.1) then
				twinkleAcc = 0
				emitTwinkle(lvl >= 2 and P.amber or col)
			end
		end
		if lvl == 3 then
			arcAcc += dt
			if arcAcc > 2 then arcAcc = math.random() * 0.8; emitArc(col) end
		end
		glintAcc += dt
		if glintAcc > 3.4 then glintAcc = 0; runGlint() end
	end
end)

