	Theme = "Dark",
	ToggleKey = CONFIG.ToggleKey,
})

local MainTab = Window:AddTab({ Title = "Predictor", Icon = "globe" })
MainTab:AddSection("Fruit Prediction")

local state = { enabled = false, current = nil }

local infoCard = MainTab:AddParagraph({
	Title = "Next Shop Fruit: Waiting",
	Content = "Turn on Enable Fruit Predictor to check the next fruit.",
})

local function buildFruitDataFromCandidate(cand)
	local sprite = getFruitSprite(cand.DisplayName)
	local rarityName = (cand.Rarity and cand.Rarity.Name) or "Common"
	return {
		name = cand.DisplayName,
		rarity = rarityName,
		icon = sprite and sprite.Image or cand.Image,
		sprite = sprite,
		source = "Dealer Gacha",
	}
end

local function revealInUI(data, noteText)
	state.current = data
	infoCard.SetTitle("Next Shop Fruit: " .. tostring(data.name))
	infoCard.SetContent(
		string.format("Rarity: %s | Source: %s%s",
			tostring(data.rarity),
			tostring(data.source or "Dealer Gacha"),
			noteText and (" | " .. tostring(noteText)) or "")
	)
end

local function runPrediction(forceNewPick)
	if not state.enabled then return end
	if forceNewPick or not nextSelectedFruit then
		nextSelectedFruit = pickCandidateFruit(gachaFlags.boostLuck)
	end
	if nextSelectedFruit then
		local data = buildFruitDataFromCandidate(nextSelectedFruit)
		revealInUI(data, "Updated " .. os.date("%H:%M:%S"))
	else
		infoCard.SetTitle("Prediction Unavailable")
		infoCard.SetContent("Couldn't read shop pool.")
	end
end

onGachaRollFinished = function(newCandidate)
	if state.enabled and newCandidate then
		local data = buildFruitDataFromCandidate(newCandidate)
		revealInUI(data, "Next roll ready")
	end
end

