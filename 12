local function runSpinSequence(targetFruit, runId)
	openPage("Spin")
	reelBoxScale.Scale = 1
	reelBoxStroke.Color = P.amber
	local ticks, seed = 16, math.random(#REEL_LIST)
	for i = 1, ticks do
		if not alive or runId ~= app.token then return false end
		local finalStep = (i == ticks)
		local item = finalStep and targetFruit or REEL_LIST[(seed + i) % #REEL_LIST + 1]
		ReelTitle.Text = item.name
		ReelTitle.TextColor3 = getRarityMeta(item.rarity).color
		setReelVisual(item.name, item.rarity, finalStep and targetFruit.sprite or nil)
		ReelTitle.Position = UDim2.fromOffset(78, -10)
		anim(ReelTitle, 0.07, { Position = UDim2.fromOffset(78, 0) })
		task.wait(0.025 + (i / ticks) ^ 3 * 0.18)
	end
	local c = getRarityMeta(targetFruit.rarity).color
	reelBoxStroke.Color = c
	reelBoxScale.Scale = 1.1
	anim(reelBoxScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
	task.wait(0.35)
	return alive and runId == app.token
end

