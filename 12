local alive, conns = true, {}
local function on(sig, fn)
	if not sig then return nil end
	local ok, c = pcall(function() return sig:Connect(fn) end)
	if ok and c then table.insert(conns, c) end
	return c
end

local function make(className, props, children)
	local ok, inst = pcall(function() return Instance.new(className) end)
	if not ok or not inst then inst = Instance.new("Frame") end
	local targetParent
	for k, v in pairs(props or {}) do
		if k == "Parent" then
			targetParent = v
		else
			pcall(function() inst[k] = v end)
		end
	end
	for _, child in ipairs(children or {}) do
		pcall(function() child.Parent = inst end)
	end
	if targetParent then
		pcall(function() inst.Parent = targetParent end)
	end
	return inst
end

local function round(px) return make("UICorner", { CornerRadius = UDim.new(0, px) }) end
local function pill() return make("UICorner", { CornerRadius = UDim.new(1, 0) }) end
local function outline(col, thick, trans)
	return make("UIStroke", { Color = col, Thickness = thick or 1, Transparency = trans or 0, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end
local function textOutline(col, thick)
	return make("UIStroke", { Color = col, Thickness = thick or 1.5, ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual })
end
local function gradient(palette, angle)
	local stops = {}
	for idx, c in ipairs(palette) do
		stops[idx] = ColorSequenceKeypoint.new((idx - 1) / math.max(#palette - 1, 1), c)
	end
	return make("UIGradient", { Color = ColorSequence.new(stops), Rotation = angle or 0 })
end
local function anim(obj, dur, goal, style, dir)
	local ok, tw = pcall(function()
		return TweenService:Create(obj, TweenInfo.new(dur, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), goal)
	end)
	if ok and tw then
		pcall(function() tw:Play() end)
		return tw
	end
	for k, v in pairs(goal or {}) do pcall(function() obj[k] = v end) end
	return nil
end
local function txt(props, kids)
	props.BackgroundTransparency = 1
	props.Font = props.Font or FONT_BODY
	props.TextSize = props.TextSize or 12
	props.TextColor3 = props.TextColor3 or P.light
	return make("TextLabel", props, kids)
end
local function box(props, kids)
	if props.BorderSizePixel == nil then props.BorderSizePixel = 0 end
	return make("Frame", props, kids)
end
local function edgeFade(centerAlpha)
	return NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.5, centerAlpha or 0),
		NumberSequenceKeypoint.new(1, 1),
	})
end

local function enableDrag(dragArea, moveTarget)
	local active = false
	local pointer = nil
	local originPos = nil
	local startFramePos = nil

	on(dragArea.InputBegan, function(inp)
		if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
			active = true
			pointer = inp
			originPos = inp.Position
			startFramePos = moveTarget.Position
			on(inp.Changed, function()
				if inp.UserInputState == Enum.UserInputState.End then
					active = false
					pointer = nil
				end
			end)
		end
	end)

	on(UIS.InputChanged, function(inp)
		if active and inp == pointer and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
			local delta = inp.Position - originPos
			moveTarget.Position = UDim2.new(
				startFramePos.X.Scale,
				startFramePos.X.Offset + delta.X,
				startFramePos.Y.Scale,
				startFramePos.Y.Offset + delta.Y
			)
		end
	end)
end

