local function packCandidate(cand)
	local spr = getFruitSprite(cand.DisplayName)
	local rName = (cand.Rarity and cand.Rarity.Name) or "Common"
	return {
		name = cand.DisplayName,
		rarity = rName,
		icon = spr and spr.Image or cand.Image,
		sprite = spr,
		source = "Dealer Gacha",
	}
end

local function queryPrediction(forceRoll)
	if forceRoll or not nextSelectedFruit then
		nextSelectedFruit = pickCandidateFruit(gachaFlags.boostLuck)
	end
	if nextSelectedFruit then
		return packCandidate(nextSelectedFruit), nil
	end
	return nil, "Couldn't read shop pool."
end

local function startPrediction(forceRoll)
	if not app.enabled or app.busy then return end
	app.busy = true
	app.token += 1
	local runId = app.token

	wipeEffects()
	updateStateBadge("Scanning")
	setActionBusy(true)
	openPage("Scan")
	BarFill.Size = UDim2.fromScale(0, 1)
	anim(BarFill, CONFIG.ScanDuration, { Size = UDim2.fromScale(0.9, 1) }, Enum.EasingStyle.Sine)

	local tStart = os.clock()
	local res, err = queryPrediction(forceRoll)
	local rem = CONFIG.ScanDuration - (os.clock() - tStart)
	if rem > 0 then task.wait(rem) end
	if not alive or runId ~= app.token then return end
	anim(BarFill, 0.15, { Size = UDim2.fromScale(1, 1) })
	task.wait(0.15)
	if not alive or runId ~= app.token then return end

	if res then
		if CONFIG.SpinAnimation and not runSpinSequence(res, runId) then return end
		app.busy = false
		setActionBusy(false)
		showResult(res)
		updateStateBadge("Detected", res.rarity)
		setClock()
		return
	end

	app.busy = false
	setActionBusy(false)
	app.current = nil
	showIdle("Prediction Unavailable", err or "Error", "error")
	updateStateBadge("Error")
	setClock("Last try failed")
end

