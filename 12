local function buildFruitDataFromCandidate(cand)
	local sprite = getFruitSprite(cand.DisplayName)
	local rarityName = (cand.Rarity and cand.Rarity.Name) or "Common"
	return {
		name = cand.DisplayName,
		rarity = rarityName,
		icon = sprite and sprite.Image or cand.Image,
		sprite = sprite,
		source = "Dealer Gacha",
	}
end

local function fetchShopPrediction(forceNewPick)
	if forceNewPick or not nextSelectedFruit then
		nextSelectedFruit = pickCandidateFruit(gachaFlags.boostLuck)
	end
	if nextSelectedFruit then
		return buildFruitDataFromCandidate(nextSelectedFruit), nil
	end
	return nil, "Couldn't read shop pool."
end

local function runPrediction(forceNewPick)
	if not state.enabled or state.busy then return end
	state.busy = true
	state.token += 1
	local my = state.token

	clearFX()
	setStatus("Scanning")
	setButtonLoading(true)
	showView("Scan")
	ProgFill.Size = UDim2.fromScale(0, 1)
	tween(ProgFill, CONFIG.ScanDuration, { Size = UDim2.fromScale(0.9, 1) }, Enum.EasingStyle.Sine)

	local t0 = os.clock()
	local res, err = fetchShopPrediction(forceNewPick)
	local left = CONFIG.ScanDuration - (os.clock() - t0)
	if left > 0 then task.wait(left) end
	if not alive or my ~= state.token then return end
	tween(ProgFill, 0.15, { Size = UDim2.fromScale(1, 1) })
	task.wait(0.15)
	if not alive or my ~= state.token then return end

	if res then
		if CONFIG.SpinAnimation and not spinReel(res, my) then return end
		state.busy = false
		setButtonLoading(false)
		reveal(res); setStatus("Detected", res.rarity); stamp()
		return
	end
	state.busy = false
	setButtonLoading(false)
	state.current = nil
	showEmpty("Prediction Unavailable", err or "Error", "error")
	setStatus("Error"); stamp("Last try failed")
end

onGachaRollFinished = function(newCandidate)
	if alive and state.enabled and newCandidate then
		local data = buildFruitDataFromCandidate(newCandidate)
		reveal(data)
		setStatus("Detected", data.rarity)
		stamp("Next roll ready")
	end
end

