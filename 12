local function attachPurchaseOverlay(parent)
	local fakeOverlay = parent:FindFirstChild("FakeOverlay")
	if fakeOverlay then fakeOverlay:Destroy() end
	local clicked = false
	local textButton = Instance.new("TextButton")
	textButton.Name = "FakeOverlay"
	textButton.Size = UDim2.fromScale(1, 1)
	textButton.BackgroundTransparency = 1
	textButton.Text = ""
	textButton.ZIndex = 100
	textButton.Parent = parent

	textButton.Activated:Connect(function()
		if clicked then return end
		if not gachaFlags.bypassCash and not hasEnoughBeli(currentPrice) then
			local diff = 0
			pcall(function() diff = currentPrice - LocalPlayer.Data.Beli.Value end)
			local formatted = TextUtil and TextUtil.commaValue and TextUtil.commaValue(diff) or tostring(diff)
			setButtonOverrideText(("Need $%s more"):format(formatted))
			task.delay(2, function() if textButton.Parent then setButtonOverrideText(gachaFlags.bypassCash and "FREE" or nil) end end)
			return
		end
		clicked = true
		task.delay(0.5, function()
			gachaHookActive = false
			textButton:Destroy()
			pcall(function() if GachaWindow then GachaWindow:Close() end end)
			task.delay(0.5, function()
				local ok3, result3 = pcall(function() return GachaWindow and GachaWindow:IsOpen() end)
				local ziolesGachaWindow = playerGui and playerGui:FindFirstChild("ZiolesGacha_Window")
				if ziolesGachaWindow and ziolesGachaWindow.Enabled and (not ok3 or result3) then ziolesGachaWindow.Enabled = false end
			end)
			executeGachaRoll(gachaFlags.boostLuck)
		end)
	end)

	for _, descendant in ipairs(parent:GetDescendants()) do
		if descendant:IsA("TextLabel") then hookButtonText(descendant) end
	end
	if isAnyBypassActive() then styleGreenButton(parent) end
end

local function processZiolesDescendant(arg)
	if arg.Name == "PurchaseButton" and arg:IsA("GuiButton") then
		if arg:FindFirstAncestor("ZiolesGacha_Window") and not arg:FindFirstChild("FakeOverlay") then attachPurchaseOverlay(arg) end
	elseif arg:IsA("TextLabel") and arg:FindFirstAncestor("PurchaseButton") and arg:FindFirstAncestor("ZiolesGacha_Window") then
		hookButtonText(arg)
	elseif isAnyBypassActive() and arg.Parent and arg.Parent.Name == "PurchaseButton" and arg:FindFirstAncestor("ZiolesGacha_Window") then
		if arg:IsA("UIStroke") then lockProp(arg, "Color", greenColors.stroke)
		elseif arg.Name == "Trans" and arg:IsA("Frame") then lockProp(arg, "BackgroundColor3", greenColors.trans) end
	end
end

