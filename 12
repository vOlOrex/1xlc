local function injectPreviewModel(arg)
	local v5 = cachedFruitModels[arg.StorageName]
	local fruit = v5 and v5:FindFirstChild("Fruit")
	local itemId = arg.ItemId
	if not fruit or not itemId then return end
	local ok3, name = pcall(function() return ItemConfig.tryGet(itemId).Index.DebugLabel end)
	if not ok3 or type(name) ~= "string" or name == "" then
		name = arg.StorageName .. " [PhysicalMoveset-" .. tostring(itemId) .. "]"
	end
	local replicatedSpinnerInstances = playerGui:FindFirstChild("__ReplicatedSpinnerInstances")
	if not replicatedSpinnerInstances then
		replicatedSpinnerInstances = Instance.new("ScreenGui")
		replicatedSpinnerInstances.Name = "__ReplicatedSpinnerInstances"
		replicatedSpinnerInstances.ResetOnSpawn = false
		replicatedSpinnerInstances.Parent = playerGui
	end
	local v6 = replicatedSpinnerInstances:FindFirstChild(name)
	if v6 then v6:Destroy() end
	local clone = fruit:Clone()
	for _, descendant in ipairs(clone:GetDescendants()) do
		if descendant:IsA("LuaSourceContainer") then descendant:Destroy() end
	end
	clone.Name = name
	local rootPart = clone:FindFirstChild("RootPart")
	if rootPart and not rootPart:IsA("BasePart") then rootPart = nil end
	clone.PrimaryPart = rootPart or clone.PrimaryPart or clone:FindFirstChildWhichIsA("BasePart", true)
	if not clone.PrimaryPart then clone:Destroy(); return end
	clone:SetAttribute("ItemId", itemId)
	clone:SetAttribute("__Size", clone:GetExtentsSize())
	clone.Parent = replicatedSpinnerInstances
	task.spawn(function()
		local Spinner = require(ReplicatedStorage.Controllers.UI.Spinner)
		local now = tick()
		while tick() - now < 5 and not Spinner:IsOpen() do task.wait(0.1) end
		while tick() - now < 600 and Spinner:IsOpen() do task.wait(0.5) end
		if clone.Parent then clone:Destroy() end
	end)
end

