	Callback = function(on)
		state.enabled = on
		if on then
			runPrediction(false)
		else
			state.current = nil
			infoCard.SetTitle("Next Shop Fruit: OFF")
			infoCard.SetContent("Turn on Enable Fruit Predictor to check the next fruit.")
		end
	end,
})

