local function getInventory()
	if not ItemConfig then return {} end
	local ok3, result3 = pcall(function()
		local ItemReplicationService = require(ReplicatedStorage.ItemReplicationService)
		local KEYS = require(ReplicatedStorage.ItemReplicationService.KEYS)
		local items = ItemReplicationService:GetItems(KEYS.IS_OWNED)
		local items2 = ItemReplicationService:GetItems(KEYS.QUANTITY)
		local items3 = ItemReplicationService:GetItems(KEYS.PREFERRED_MUTATION)
		local tbl2 = {}

		if type(items2) == "table" then
			for _, v2 in pairs(items2) do
				if v2.ItemId then
					tbl2[v2.ItemId] = v2.Value
				end
			end
		end

		local tbl3 = {}
		if type(items3) == "table" then
			for _, v2 in pairs(items3) do
				if v2.ItemId and v2.Value and v2.Value ~= "" then
					tbl3[v2.ItemId] = true
				end
			end
		end

		local tbl4 = {}
		if type(items) == "table" then
			for _, item in pairs(items) do
				if item.Value == true and item.ItemId then
					local ok4, res4 = pcall(function()
						return ItemConfig.tryGet(item.ItemId)
					end)

					if ok4 and type(res4) == "table" and res4.Display and res4.Display.Category == "Blox Fruit" then
						local storageKey = res4.Index and res4.Index.StorageKey
						local name = res4.Display.Name
						storageKey = name and name ~= "" and name or storageKey or ""
						local idType = res4.Index and res4.Index.IdType
						local str3

						if idType == "PhysicalMoveset" then
							str3 = tbl3[item.ItemId] and "Mutated Fruit" or "Blox Fruit"
						elseif idType == "Redeemable" then
							str3 = "Premium"
						end

						if str3 then
							table.insert(tbl4, {
								ItemId = item.ItemId,
								Id = item.ItemId,
								Name = res4.Index and res4.Index.StorageKey or storageKey,
								DisplayName = storageKey,
								Type = str3,
								Rarity = res4.Quality and res4.Quality.RarityValue or 0,
								Value = res4.Quality and res4.Quality.MoneyPrice or 0,
								Count = tbl2[item.ItemId] or 1,
							})
						end
					end
				end
			end
		end

		return tbl4
	end)

	if not ok3 then return {} end
	return result3 or {}
end

