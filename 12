local function buildFruitEmblem(parent, diameter, zIdx, offsetPos)
	local sphere = box({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = offsetPos or UDim2.new(0.5, 0, 0.5, diameter * 0.06),
		Size = UDim2.fromOffset(diameter, diameter),
		BackgroundColor3 = P.white,
		ZIndex = zIdx,
		Parent = parent,
	}, { pill() })

	local g = gradient({ P.aqua, P.azure }, 135)
	g.Parent = sphere
	outline(P.ink, math.max(1, diameter / 26), 0.1).Parent = sphere

	local rings = {}
	for i, cfg in ipairs({ { 0.66, -0.06, 0.02, 40 }, { 0.4, 0.1, 0.1, 160 }, { 0.2, -0.04, 0.16, 280 } }) do
		local rFrame = box({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5 + cfg[2], 0.5 + cfg[3]),
			Size = UDim2.fromScale(cfg[1], cfg[1]),
			BackgroundTransparency = 1,
			ZIndex = zIdx + 1,
			Parent = sphere,
		}, { pill() })
		local st = outline(P.ink, math.max(1, diameter / 22), 0.35)
		st.Parent = rFrame
		make("UIGradient", { Rotation = cfg[4], Transparency = SWIRL_SEQ, Parent = st })
		rings[i] = st
	end

	box({
		Position = UDim2.fromScale(0.18, 0.14),
		Size = UDim2.fromScale(0.26, 0.16),
		Rotation = -30,
		BackgroundColor3 = P.white,
		BackgroundTransparency = 0.45,
		ZIndex = zIdx + 2,
		Parent = sphere,
	}, { pill() })

	box({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 0, diameter * 0.08),
		Size = UDim2.fromOffset(math.max(2, diameter * 0.07), diameter * 0.2),
		Rotation = 12,
		BackgroundColor3 = Color3.fromRGB(70, 45, 25),
		ZIndex = zIdx + 2,
		Parent = sphere,
	}, { round(2) })

	box({
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0.5, 1, 0, diameter * 0.04),
		Size = UDim2.fromOffset(diameter * 0.3, diameter * 0.15),
		Rotation = -22,
		BackgroundColor3 = Color3.fromRGB(70, 220, 120),
		ZIndex = zIdx + 2,
		Parent = sphere,
	}, { pill(), outline(P.ink, 1, 0.3) })

	return { body = sphere, grad = g, swirls = rings }
end

