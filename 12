local PAGES = { Idle = IdlePage, Scan = ScanPage, Spin = SpinPage, Show = ShowPage }
local function openPage(name)
	if app.page == name then return end
	for k, p in pairs(PAGES) do p.Visible = (k == name) end
	app.page = name
	local target = PAGES[name]
	target.Position = UDim2.fromOffset(0, 10)
	anim(target, 0.35, { Position = UDim2.fromOffset(0, 0) }, Enum.EasingStyle.Back)
end

local function wipeEffects()
	app.fxColor, app.fxTier, app.beamsOn = nil, 0, false
	for _, ch in ipairs(ParticleLayer:GetChildren()) do ch:Destroy() end
	for _, b in ipairs(lightBeams) do b.BackgroundTransparency = 1 end
	anim(stageBorder, 0.3, { Color = P.border, Transparency = 0 })
	anim(stageTint, 0.3, { BackgroundTransparency = 1 })
	anim(AmbientGlow, 0.4, { BackgroundColor3 = P.azure, BackgroundTransparency = 0.88 })
end

local function showIdle(titleStr, descStr, mode)
	wipeEffects()
	IdleHeading.Text, IdleDesc.Text = titleStr, descStr
	local c = (mode == "error" and P.danger) or (mode == "source" and P.aqua) or P.muted
	IdleGlyph.Text = (mode == "error" and "!") or (mode == "source" and "i") or "?"
	IdleGlyph.TextColor3 = c
	idleCircleStroke.Color = mode and c or P.border
	openPage("Idle")
end

