local function safeResolveItemId(str3)
	if not ItemId or type(ItemId.getId) ~= "function" then return nil end
	local ok, raw = pcall(function() return ItemId.getId(str3, "PhysicalMoveset") end)
	if not ok or not raw then return nil end
	local val = raw
	if type(raw) == "table" and type(raw.asNullable) == "function" then
		local okN, resN = pcall(function() return raw:asNullable() end)
		if okN then val = resN end
	end
	if not val then return nil end
	return type(val) == "table" and (val.ItemId or val.Id) or val
end

local spriteCache = {}
local function getFruitSprite(arg)
	if spriteCache[arg] ~= nil then
		return spriteCache[arg] or nil
	end
	if not ItemConfig or type(ItemConfig.tryGet) ~= "function" then
		spriteCache[arg] = false
		return nil
	end
	local itemId = safeResolveItemId(arg .. "-" .. arg)
	if not itemId then
		spriteCache[arg] = false
		return nil
	end
	local ok4, result4 = pcall(function()
		return ItemConfig.tryGet(itemId)
	end)
	if ok4 and type(result4) == "table" and result4.Display and result4.Display.Sprite then
		spriteCache[arg] = result4.Display.Sprite
		return result4.Display.Sprite
	end
	spriteCache[arg] = false
	return nil
end

local function getFruitItemId(arg)
	return safeResolveItemId(arg .. "-" .. arg)
end

local spriteMap = {}

local function registerFruit(arg, arg2)
	local ok, data = pcall(function()
		local str3 = arg .. "-" .. arg
		local v2 = getFruitSprite(arg)
		local image, imageRectOffset, imageRectSize

		if v2 then
			image = v2.Image
			imageRectOffset = v2.ImageRectOffset or Vector2.new(0, 0)
			imageRectSize = v2.ImageRectSize or Vector2.new(0, 0)
		else
			imageRectSize = Vector2.new(0, 0)
			imageRectOffset = Vector2.new(0, 0)
			image = nil
		end

		spriteMap[str3] = arg

		return {
			StorageName = str3,
			DisplayName = arg,
			ImageName = str3,
			ItemId = getFruitItemId(arg),
			Image = image,
			ImageRectOffset = imageRectOffset,
			ImageRectSize = imageRectSize,
			Rarity = { Name = RARITY_NAMES[arg2], Value = arg2, Color = RARITY_COLORS[arg2] },
			Attributes = {},
			Filter = nil,
			ItemType = "Item",
			Awards = nil,
			_UID = genUID(),
		}
	end)

	if ok and data then return data end
	return {
		StorageName = arg .. "-" .. arg,
		DisplayName = arg,
		ImageName = arg .. "-" .. arg,
		Rarity = { Name = RARITY_NAMES[arg2], Value = arg2, Color = RARITY_COLORS[arg2] },
		_UID = genUID(),
	}
end

