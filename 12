------------------------------------------------------------------------
-- STATE & EFFECTS
------------------------------------------------------------------------
local state = { enabled = false, busy = false, token = 0, minimized = false,
	status = "Waiting", current = nil, view = nil, fx = nil, fxLevel = 0, rays = false }
local function rarityInfo(r) return RARITY[r] or RARITY.Unknown end

local function setStatus(kind, rarity)
	state.status = kind
	local col = (kind == "Scanning" and C.cyan) or (kind == "Error" and C.red)
		or (kind == "Detected" and rarityInfo(rarity).color) or C.gray
	StatusText.Text = kind
	tween(StatusText, 0.25, { TextColor3 = col })
	tween(StatusDot, 0.25, { BackgroundColor3 = col, BackgroundTransparency = 0 })
	tween(StatusChip, 0.25, { BackgroundColor3 = col })
	tween(statusStroke, 0.25, { Color = col })
end
local function stamp(text) UpdatedLbl.Text = text or ("Updated " .. os.date("%H:%M:%S")) end

local VIEWS = { Empty = EmptyView, Scan = ScanView, Reel = ReelView, Result = ResultView }
local function showView(name)
	if state.view == name then return end
	for n, v in pairs(VIEWS) do v.Visible = (n == name) end
	state.view = name
	local v = VIEWS[name]
	v.Position = UDim2.fromOffset(0, 10)
	tween(v, 0.35, { Position = UDim2.fromOffset(0, 0) }, Enum.EasingStyle.Back)
end

local function clearFX()
	state.fx, state.fxLevel, state.rays = nil, 0, false
	for _, c in ipairs(FX:GetChildren()) do c:Destroy() end
	for _, r in ipairs(rays) do r.BackgroundTransparency = 1 end
	tween(cardStroke, 0.3, { Color = C.line, Transparency = 0 })
	tween(cardTint, 0.3, { BackgroundTransparency = 1 })
	tween(Haze, 0.4, { BackgroundColor3 = C.blue, BackgroundTransparency = 0.88 })
end

local function showEmpty(title, sub, kind)
	clearFX()
	EmptyTitle.Text, EmptySub.Text = title, sub
	local col = (kind == "error" and C.red) or (kind == "source" and C.cyan) or C.sub
	EmptyGlyph.Text = (kind == "error" and "!") or (kind == "source" and "i") or "?"
	EmptyGlyph.TextColor3 = col
	emptyIconStroke.Color = kind and col or C.line
	showView("Empty")
end

local function setButtonEnabled(on)
	refreshGrad.Enabled = on
	tween(RefreshBtn, 0.3, { BackgroundColor3 = on and C.white or C.off })
	tween(RefreshLbl, 0.3, { TextColor3 = on and C.white or C.sub })
end
local function setButtonLoading(on)
	Spinner.Visible = on
	RefreshLbl.Text = on and "    Scanning..." or "Refresh Fruit"
end

local function fxCount() return #FX:GetChildren() end

local function spawnParticle(color, fromX, fromY, dx, dy, life)
	if fxCount() > 42 then return end
	local sz = math.random(3, 6)
	local p = frame({ AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(sz, sz),
		Position = UDim2.fromOffset(fromX or math.random(24, CARD_W - 24), fromY or math.random(110, CARD_H - 10)),
		BackgroundColor3 = (math.random() < 0.3) and C.white or color, BackgroundTransparency = 0.05, ZIndex = 5, Parent = FX }, { circle() })
	tween(p, life or math.random(12, 20) / 10, {
		Position = p.Position + UDim2.fromOffset(dx or math.random(-14, 14), dy or -math.random(50, 100)),
		BackgroundTransparency = 1, Size = UDim2.fromOffset(1, 1),
	}, Enum.EasingStyle.Sine).Completed:Connect(function() p:Destroy() end)
end

local function spawnStar(color)
	if fxCount() > 42 then return end
	local s = frame({ AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(12, 12), BackgroundTransparency = 1,
		Position = UDim2.fromOffset(math.random(12, CARD_W - 12), math.random(12, CARD_H - 30)), Rotation = math.random(0, 45),
		ZIndex = 5, Parent = FX })
	local sc = new("UIScale", { Scale = 0.2, Parent = s })
	local bars = {
		frame({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(1, 0, 0, 2),
			BackgroundColor3 = color, BackgroundTransparency = 1, Parent = s }, { circle() }),
		frame({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0, 2, 1, 0),
			BackgroundColor3 = C.white, BackgroundTransparency = 1, Parent = s }, { circle() }),
	}
	tween(sc, 0.35, { Scale = 1.2 }, Enum.EasingStyle.Back)
	for _, b in ipairs(bars) do tween(b, 0.35, { BackgroundTransparency = 0 }) end
	task.delay(0.4, function()
		if not s.Parent then return end
		tween(sc, 0.5, { Scale = 0 })
		for _, b in ipairs(bars) do tween(b, 0.5, { BackgroundTransparency = 1 }) end
		task.delay(0.55, function() s:Destroy() end)
	end)
end

local function spawnShockwave(color)
	local ring = frame({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(ICON_X, ICON_Y), Size = UDim2.fromOffset(72, 72),
		BackgroundTransparency = 1, ZIndex = 5, Parent = FX }, { circle() })
	local st = stroke(color, 3, 0.1); st.Parent = ring
	local sc = new("UIScale", { Scale = 1, Parent = ring })
	tween(sc, 0.8, { Scale = 2.4 }, Enum.EasingStyle.Quad)
	tween(st, 0.8, { Transparency = 1, Thickness = 1 }).Completed:Connect(function() ring:Destroy() end)
end

local function spawnLightning(color)
	local ang = math.random() * math.pi * 2
	local x, y = ICON_X + math.cos(ang) * 40, ICON_Y + math.sin(ang) * 40
	local parts = {}
	for _ = 1, 4 do
		local len = math.random(9, 16)
		local a = ang + (math.random() - 0.5) * 1.6
		local nx, ny = x + math.cos(a) * len, y + math.sin(a) * len
		local mid = UDim2.fromOffset((x + nx) / 2, (y + ny) / 2)
		table.insert(parts, frame({ AnchorPoint = Vector2.new(0.5, 0.5), Position = mid, Size = UDim2.fromOffset(len + 2, 7),
			Rotation = math.deg(a), BackgroundColor3 = color, BackgroundTransparency = 0.5, ZIndex = 5, Parent = FX }, { circle() }))
		table.insert(parts, frame({ AnchorPoint = Vector2.new(0.5, 0.5), Position = mid, Size = UDim2.fromOffset(len + 2, 2),
			Rotation = math.deg(a), BackgroundColor3 = C.white, ZIndex = 5, Parent = FX }))
		x, y = nx, ny
	end
	cardTint.BackgroundTransparency = 0.75
	tween(cardTint, 0.35, { BackgroundTransparency = 0.9 })
	for _, p in ipairs(parts) do tween(p, 0.3, { BackgroundTransparency = 1 }).Completed:Connect(function() p:Destroy() end) end
end

local function shineSweep()
	Shine.Position = UDim2.new(-0.3, 0, 0.5, 0)
	tween(Shine, 0.85, { Position = UDim2.new(1.3, 0, 0.5, 0) }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
end

local function shake(power)
	task.spawn(function()
		for i = 1, 7 do
			local p = math.max(1, math.floor(power * (1 - i / 8)))
			Pop.Position = UDim2.fromOffset(math.random(-p, p), math.random(-p, p))
			task.wait(0.03)
		end
		Pop.Position = UDim2.fromOffset(0, 0)
	end)
end

------------------------------------------------------------------------
-- REEL + REVEAL
------------------------------------------------------------------------
local function applyReelFruitVisual(fruitName, rarityName, spriteData)
	local col = rarityInfo(rarityName).color
	reelIconStroke.Color = col
	local spr = spriteData or getFruitSprite(fruitName)
	if spr and spr.Image then
		ReelImage.Image = spr.Image
		ReelImage.ImageRectOffset = spr.ImageRectOffset or Vector2.new(0, 0)
		ReelImage.ImageRectSize = spr.ImageRectSize or Vector2.new(0, 0)
		ReelImage.Visible = true
		reelFruitFallback.body.Visible = false
	else
		ReelImage.Visible = false
		reelFruitFallback.body.Visible = true
		paintFruit(reelFruitFallback, rarityName)
	end
end

local function spinReel(final, my)
	showView("Reel")
	slotScale.Scale = 1
	slotStroke.Color = C.gold
	local steps, start = 16, math.random(#REEL_LIST)
	for i = 1, steps do
		if not alive or my ~= state.token then return false end
		local isLast = (i == steps)
		local pick = isLast and final or REEL_LIST[(start + i) % #REEL_LIST + 1]
		ReelName.Text = pick.name
		ReelName.TextColor3 = rarityInfo(pick.rarity).color
		applyReelFruitVisual(pick.name, pick.rarity, isLast and final.sprite or nil)
		ReelName.Position = UDim2.fromOffset(78, -10)
		tween(ReelName, 0.07, { Position = UDim2.fromOffset(78, 0) })
		task.wait(0.025 + (i / steps) ^ 3 * 0.18)
	end
	local col = rarityInfo(final.rarity).color
	slotStroke.Color = col
	slotScale.Scale = 1.1
	tween(slotScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
	task.wait(0.35)
	return alive and my == state.token
end

local function reveal(data)
	state.current = data
	local info = rarityInfo(data.rarity)
	local col = info.color
	local special = info.fx >= 2
	clearFX()
	state.fx, state.fxLevel, state.rays = col, info.fx, info.fx >= 1

	NameLbl.Text = data.name
	NameLbl.TextColor3 = col
	BadgeText.Text = string.upper(data.rarity)
	BadgeText.TextColor3 = C.white
	Badge.BackgroundColor3 = col
	badgeStroke.Color = special and C.gold or C.ink
	DetailLbl.Text = string.format('Shop Drop: <b>%s</b>  |  Rarity: <font color="#%s"><b>%s</b></font>',
		data.name, col:ToHex(), data.rarity)
	GlowRing.BackgroundColor3, ringStroke.Color, Halo.BackgroundColor3 = col, col, col
	iconStroke.Color = special and C.gold or col
	for i, r in ipairs(rays) do r.BackgroundColor3 = (info.fx == 3 and i % 2 == 0) and C.gold or col end
	paintFruit(bigFruit, data.rarity)
	cardTint.BackgroundColor3 = col
	tween(cardTint, 0.5, { BackgroundTransparency = 0.9 })
	tween(cardStroke, 0.4, { Color = special and C.gold or col })
	tween(Haze, 0.5, { BackgroundColor3 = col, BackgroundTransparency = 0.78 })

	if data.sprite and data.sprite.Image then
		IconImage.Image = data.sprite.Image
		IconImage.ImageRectOffset = data.sprite.ImageRectOffset or Vector2.new(0, 0)
		IconImage.ImageRectSize = data.sprite.ImageRectSize or Vector2.new(0, 0)
		IconImage.Visible = true
		bigFruit.body.Visible = false
	elseif data.icon then
		IconImage.Image = data.icon
		IconImage.ImageRectOffset = Vector2.new(0, 0)
		IconImage.ImageRectSize = Vector2.new(0, 0)
		IconImage.Visible = true
		bigFruit.body.Visible = false
	else
		IconImage.Visible = false
		bigFruit.body.Visible = true
	end

	showView("Result")
	Flash.BackgroundTransparency = special and 0.15 or 0.45
	tween(Flash, 0.6, { BackgroundTransparency = 1 })
	if special then shake(info.fx == 3 and 6 or 4) end

	iconScale.Scale = 0
	tween(iconScale, 0.34, { Scale = 1.18 }, Enum.EasingStyle.Back).Completed:Connect(function()
		tween(iconScale, 0.2, { Scale = 1 }, Enum.EasingStyle.Sine)
	end)
	NameLbl.Position = UDim2.fromOffset(0, 116); NameLbl.TextTransparency = 1
	tween(NameLbl, 0.45, { Position = UDim2.fromOffset(0, 104), TextTransparency = 0 }, Enum.EasingStyle.Back)
	Badge.Position = UDim2.new(0.5, 0, 0, 142); Badge.BackgroundTransparency = 1; BadgeText.TextTransparency = 1
	task.delay(0.12, function()
		tween(Badge, 0.4, { Position = UDim2.new(0.5, 0, 0, 130), BackgroundTransparency = 0 }, Enum.EasingStyle.Back)
		tween(BadgeText, 0.4, { TextTransparency = 0 })
	end)

	spawnShockwave(col)
	if special then task.delay(0.15, function() spawnShockwave(C.gold) end) end
	local n = 10 + info.fx * 5
	for i = 1, n do
		local a = (i / n) * math.pi * 2
		spawnParticle((special and i % 3 == 0) and C.gold or col, ICON_X, ICON_Y,
			math.cos(a) * math.random(50, 80), math.sin(a) * math.random(50, 80), 0.75)
	end
	task.delay(0.3, shineSweep)
end

