	end
	local str3 = arg .. "-" .. arg
	local ok3, result3 = pcall(function()
		return ItemId.getId(str3, "PhysicalMoveset"):asNullable()
	end)
	if not ok3 or not result3 then
		spriteCache[arg] = false
		return nil
	end
	local itemId = type(result3) == "table" and (result3.ItemId or result3.Id) or result3
	local ok4, result4 = pcall(function()
		return ItemConfig.tryGet(itemId)
	end)
