	tbl15.conn = arg:GetPropertyChangedSignal(arg2):Connect(function()
		if arg[arg2] ~= tbl15.want then
			tbl15.orig = arg[arg2]
			arg[arg2] = tbl15.want
		end
	end)
	hookedProps[arg] = tbl15
	arg[arg2] = arg3
end

local function unlockAllProps()
