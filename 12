local function emitPulse(col)
	local ring = box({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(CENTER_X, CENTER_Y),
		Size = UDim2.fromOffset(72, 72),
		BackgroundTransparency = 1,
		ZIndex = 5,
		Parent = ParticleLayer,
	}, { pill() })
	local st = outline(col, 3, 0.1); st.Parent = ring
	local sc = make("UIScale", { Parent = ring })
	anim(sc, 0.8, { Scale = 2.4 }, Enum.EasingStyle.Quad)
	anim(st, 0.8, { Transparency = 1, Thickness = 1 }).Completed:Connect(function() ring:Destroy() end)
end

local function emitArc(col)
	local ang = math.random() * math.pi * 2
	local px, py = CENTER_X + math.cos(ang) * 40, CENTER_Y + math.sin(ang) * 40
	local segs = {}
	for _ = 1, 4 do
		local segLen = math.random(9, 16)
		local segAng = ang + (math.random() - 0.5) * 1.6
		local nx, ny = px + math.cos(segAng) * segLen, py + math.sin(segAng) * segLen
		local midPos = UDim2.fromOffset((px + nx) / 2, (py + ny) / 2)
		table.insert(segs, box({ AnchorPoint = Vector2.new(0.5, 0.5), Position = midPos, Size = UDim2.fromOffset(segLen + 2, 7),
			Rotation = math.deg(segAng), BackgroundColor3 = col, BackgroundTransparency = 0.5, ZIndex = 5, Parent = ParticleLayer }, { pill() }))
		table.insert(segs, box({ AnchorPoint = Vector2.new(0.5, 0.5), Position = midPos, Size = UDim2.fromOffset(segLen + 2, 2),
			Rotation = math.deg(segAng), BackgroundColor3 = P.white, ZIndex = 5, Parent = ParticleLayer }))
		px, py = nx, ny
	end
	stageTint.BackgroundTransparency = 0.75
	anim(stageTint, 0.35, { BackgroundTransparency = 0.9 })
	for _, s in ipairs(segs) do anim(s, 0.3, { BackgroundTransparency = 1 }).Completed:Connect(function() s:Destroy() end) end
end

