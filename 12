local function captureAlpha(root)
	local snap = {}
	for _, item in ipairs(root:GetDescendants()) do
		if item:IsA("GuiObject") then
			local entry = { o = item, p = { BackgroundTransparency = item.BackgroundTransparency } }
			if item:IsA("TextLabel") or item:IsA("TextButton") then
				entry.p.TextTransparency = item.TextTransparency
			end
			if item:IsA("ImageLabel") then
				entry.p.ImageTransparency = item.ImageTransparency
			end
			table.insert(snap, entry)
		elseif item:IsA("UIStroke") then
			table.insert(snap, { o = item, p = { Transparency = item.Transparency } })
		end
	end
	return snap
end

local function fadeGroup(snap, visible, timeLen)
	for _, entry in ipairs(snap) do
		local goal = {}
		for propName, propVal in pairs(entry.p) do
			if visible then
				entry.o[propName] = 1
				goal[propName] = propVal
			else
				goal[propName] = 1
			end
		end
		anim(entry.o, timeLen, goal)
	end
end

