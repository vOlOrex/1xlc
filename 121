	local function spawnLightning(color)
		local ang = math.random() * math.pi * 2
		local x, y = ICON_X + math.cos(ang) * 40, ICON_Y + math.sin(ang) * 40
		local parts = {}
		for _ = 1, 4 do
			local len = math.random(9, 16)
			local a = ang + (math.random() - 0.5) * 1.6
			local nx, ny = x + math.cos(a) * len, y + math.sin(a) * len
			local mid = UDim2.fromOffset((x + nx) / 2, (y + ny) / 2)
			table.insert(parts, frame({ AnchorPoint = Vector2.new(0.5, 0.5), Position = mid, Size = UDim2.fromOffset(len + 2, 7),
				Rotation = math.deg(a), BackgroundColor3 = color, BackgroundTransparency = 0.5, ZIndex = 5, Parent = UI.FX }, { circle() }))
			table.insert(parts, frame({ AnchorPoint = Vector2.new(0.5, 0.5), Position = mid, Size = UDim2.fromOffset(len + 2, 2),
				Rotation = math.deg(a), BackgroundColor3 = C.white, ZIndex = 5, Parent = UI.FX }))
			x, y = nx, ny
		end
		UI.cardTint.BackgroundTransparency = 0.75
		tween(UI.cardTint, 0.35, { BackgroundTransparency = 0.9 })
		for _, p in ipairs(parts) do tween(p, 0.3, { BackgroundTransparency = 1 }).Completed:Connect(function() p:Destroy() end) end
	end

	local function shineSweep()
		UI.Shine.Position = UDim2.new(-0.3, 0, 0.5, 0)
		tween(UI.Shine, 0.85, { Position = UDim2.new(1.3, 0, 0.5, 0) }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
	end

	local function shake(power)
		task.spawn(function()
			for i = 1, 7 do
				if not alive then return end
				local p = math.max(1, math.floor(power * (1 - i / 8)))
				UI.Pop.Position = UDim2.fromOffset(math.random(-p, p), math.random(-p, p))
				task.wait(0.03)
			end
			if alive then UI.Pop.Position = UDim2.fromOffset(0, 0) end
		end)
	end

	local function spinReel(finalEntry, my)
		showView("Reel")
		UI.slotScale.Scale = 1
		UI.slotStroke.Color = C.gold
		local steps, start = 16, math.random(#AllFruits)
		for i = 1, steps do
			if not alive or my ~= state.token then return false end
			local pick = (i == steps) and finalEntry or AllFruits[(start + i) % #AllFruits + 1]
			local rName = pick.Rarity.Name
			UI.ReelName.Text = pick.DisplayName
			UI.ReelName.TextColor3 = rarityInfo(rName).color
			paintFruit(UI.reelFruit, rName)
			UI.ReelName.Position = UDim2.fromOffset(66, -10)
			tween(UI.ReelName, 0.07, { Position = UDim2.fromOffset(66, 0) })
			task.wait(0.03 + (i / steps) ^ 3 * 0.20)
		end
		local col = rarityInfo(finalEntry.Rarity.Name).color
		UI.slotStroke.Color = col
		UI.slotScale.Scale = 1.12
		tween(UI.slotScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
		task.wait(0.35)
		return alive and my == state.token
	end

	local function revealFruit(entry)
		state.current = entry
		local rName = entry.Rarity.Name
		local info = rarityInfo(rName)
		local col = info.color
		local special = info.fx >= 2
		clearFX()
		state.fx, state.fxLevel, state.rays = col, info.fx, info.fx >= 1

		UI.NameLbl.Text = entry.DisplayName
		UI.NameLbl.TextColor3 = col
		UI.BadgeText.Text = string.upper(rName)
		UI.BadgeText.TextColor3 = C.white
		UI.Badge.BackgroundColor3 = col
		UI.badgeStroke.Color = special and C.gold or C.ink
		UI.DetailLbl.Text = string.format('Next Spin: <b>%s</b>  |  Rarity: <font color="#%s"><b>%s</b></font>',
			entry.DisplayName, toHex(col), rName)
		UI.GlowRing.BackgroundColor3, UI.ringStroke.Color, UI.Halo.BackgroundColor3 = col, col, col
		UI.iconStroke.Color = special and C.gold or col
		for i, r in ipairs(rays) do r.BackgroundColor3 = (info.fx == 3 and i % 2 == 0) and C.gold or col end
		paintFruit(UI.bigFruit, rName)
		UI.cardTint.BackgroundColor3 = col
		tween(UI.cardTint, 0.5, { BackgroundTransparency = 0.9 })
		tween(UI.cardStroke, 0.4, { Color = special and C.gold or col })
		tween(UI.Haze, 0.5, { BackgroundColor3 = col, BackgroundTransparency = 0.72 })

		-- عرض الأيقونة الحقيقية للفاكهة من اللعبة إن وجدت
		if entry.Image then
			UI.IconImage.Image = entry.Image
			UI.IconImage.ImageRectOffset = entry.ImageRectOffset
			UI.IconImage.ImageRectSize = entry.ImageRectSize
			UI.IconImage.Visible = true
			UI.bigFruit.body.Visible = false
		else
			UI.IconImage.Visible = false
			UI.bigFruit.body.Visible = true
		end

		showView("Result")
		UI.Flash.BackgroundTransparency = special and 0.15 or 0.45
		tween(UI.Flash, 0.6, { BackgroundTransparency = 1 })
		if special then shake(info.fx == 3 and 6 or 4) end

		UI.iconScale.Scale = 0
		tween(UI.iconScale, 0.34, { Scale = 1.18 }, Enum.EasingStyle.Back).Completed:Connect(function()
			tween(UI.iconScale, 0.2, { Scale = 1 }, Enum.EasingStyle.Sine)
		end)
		UI.NameLbl.Position = UDim2.fromOffset(0, 116); UI.NameLbl.TextTransparency = 1
		tween(UI.NameLbl, 0.45, { Position = UDim2.fromOffset(0, 104), TextTransparency = 0 }, Enum.EasingStyle.Back)
		UI.Badge.Position = UDim2.new(0.5, 0, 0, 142); UI.Badge.BackgroundTransparency = 1; UI.BadgeText.TextTransparency = 1
		task.delay(0.12, function()
			if not alive then return end
			tween(UI.Badge, 0.4, { Position = UDim2.new(0.5, 0, 0, 130), BackgroundTransparency = 0 }, Enum.EasingStyle.Back)
			tween(UI.BadgeText, 0.4, { TextTransparency = 0 })
		end)

		spawnShockwave(col)
		if special then task.delay(0.15, function() if alive then spawnShockwave(C.gold) end end) end
		local n = 10 + info.fx * 5
		if IS_TOUCH then n = math.floor(n * 0.7) end
		for i = 1, n do
			local a = (i / n) * math.pi * 2
			spawnParticle((special and i % 3 == 0) and C.gold or col, ICON_X, ICON_Y,
				math.cos(a) * math.random(50, 80), math.sin(a) * math.random(50, 80), 0.75)
		end
		task.delay(0.3, function() if alive then shineSweep() end end)
	end

	local function runPrediction(forceNew)
		if not state.enabled or state.busy then return end
		state.busy = true
		state.token += 1
		local my = state.token

		clearFX()
		setStatus("Scanning")
		setButtonLoading(true)
		showView("Scan")
		UI.ProgFill.Size = UDim2.fromScale(0, 1)
		tween(UI.ProgFill, CONFIG.ScanDuration, { Size = UDim2.fromScale(0.95, 1) }, Enum.EasingStyle.Sine)

		if forceNew or not nextPredictedFruit then
			nextPredictedFruit = rollNextFruit(BypassState.boostLuck)
		end

		task.wait(CONFIG.ScanDuration)
		if not alive or my ~= state.token then return end
		tween(UI.ProgFill, 0.15, { Size = UDim2.fromScale(1, 1) })
		task.wait(0.15)
		if not alive or my ~= state.token then return end

		if CONFIG.SpinAnimation and not spinReel(nextPredictedFruit, my) then return end
		state.busy = false
		setButtonLoading(false)
		revealFruit(nextPredictedFruit)
		setStatus("Detected", nextPredictedFruit.Rarity.Name)
		stamp()
	end

	ENV.__RefreshPredictorCard = function()
		if state.enabled and not state.busy then
			runPrediction(false)
		end
	end

	local function setEnabled(on)
		state.enabled = on
		tween(UI.Knob, 0.3, { Position = on and UDim2.new(1, -18, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
			BackgroundColor3 = on and C.white or Color3.fromRGB(185, 192, 212) }, Enum.EasingStyle.Back)
		UI.switchGrad.Enabled = on
		tween(UI.Switch, 0.25, { BackgroundColor3 = on and C.white or C.off })
		tween(UI.toggleRowStroke, 0.25, { Color = on and C.cyan or C.line })
		UI.toggleSub.Text = on and "ON (Gacha Hooked)" or "OFF"
		UI.toggleSub.TextColor3 = on and C.cyan or C.sub
		setButtonEnabled(on)
		if on then
			task.spawn(function() runPrediction(true) end)
		else
			state.token += 1
			state.busy, state.current, nextPredictedFruit = false, nil, nil
			setButtonLoading(false)
			showEmpty("No Fruit Detected", "Turn on the predictor to scan.")
			setStatus("Waiting"); stamp("No data yet")
		end
	end

	------------------------------------------------------------------
	-- INTERACTIONS & DRAG
	------------------------------------------------------------------
	local function isPress(input)
		return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
	end

	local function makeDraggable(handle, getXY, setXY, onTap)
		local dragging, dragInput, startIn, sx, sy, moved = false, nil, nil, 0, 0, 0
		local function finish(isTap)
			if not dragging then return end
			dragging = false
			if isTap and onTap and moved < 8 then onTap() end
		end
		bind(handle.InputBegan, function(input)
			if not isPress(input) or dragging then return end
			dragging, dragInput, startIn, moved = true, input, input.Position, 0
			sx, sy = getXY()
			local c
			c = input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					c:Disconnect()
					if dragInput == input then finish(true) end
				end
			end)
		end)
		bind(UIS.InputChanged, function(input)
			if not dragging then return end
			local same = (input == dragInput)
				or (dragInput.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseMovement)
			if not same then return end
			local dx, dy = input.Position.X - startIn.X, input.Position.Y - startIn.Y
			moved = math.max(moved, math.sqrt(dx * dx + dy * dy))
			setXY(sx + dx, sy + dy)
		end)
		bind(UIS.InputEnded, function(input)
			if not dragging then return end
			if input == dragInput or (dragInput.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseButton1) then
				finish(true)
			end
		end)
	end

	bind(UI.ToggleHit.Activated, function() setEnabled(not state.enabled) end)

	bind(UI.RefreshBtn.Activated, function()
		if not state.enabled then
			UI.toggleRowStroke.Color = C.cyan
			tween(UI.ToggleRow, 0.08, { Position = UDim2.fromOffset(15, 8) }).Completed:Connect(function()
				tween(UI.ToggleRow, 0.35, { Position = UDim2.fromOffset(10, 8) }, Enum.EasingStyle.Elastic)
				tween(UI.toggleRowStroke, 0.6, { Color = C.line })
			end)
			return
		end
		task.spawn(function() runPrediction(true) end)
	end)

	bind(UI.MinHit.Activated, function()
		state.minimized = not state.minimized
		UI.MinBtn.Text = state.minimized and "+" or "–"
		local h = state.minimized and HEADER or H
		local s = UI.rootScale.Scale
		if not state.minimized then UI.Body.Visible = true end
		tween(UI.Holder, 0.35, { Size = UDim2.fromOffset(W, h) })
		tween(UI.Anchor, 0.35, { Size = UDim2.fromOffset(W * s, h * s) })
		clampPos(0.35)
		if state.minimized then
			task.delay(0.4, function()
				if alive and state.minimized then UI.Body.Visible = false end
			end)
		end
	end)

	bind(UI.CloseHit.Activated, destroyAll)

	bind(UIS.InputBegan, function(input, gp)
		if not gp and input.KeyCode == CONFIG.ToggleKey then setVisible(not state.visible) end
	end)

	makeDraggable(UI.DragZone,
		function() return pos.x, pos.y end,
		function(x, y) pos.moved = true; pos.x, pos.y = x, y; clampPos() end)

	if CONFIG.MobileOrb and IS_TOUCH then
		guard("orb", function()
			UI.Orb = new("TextButton", { Name = "Orb", AutoButtonColor = false, Text = "", Position = UDim2.fromOffset(12, 120),
				Size = UDim2.fromOffset(40, 40), BackgroundColor3 = C.panel, ZIndex = 50, Parent = gui }, { circle() })
			local os_ = attach(stroke(C.white, 2, 0), UI.Orb)
			UI.orbGrad = attach(grad({ C.cyan, C.purple, C.blue, C.cyan }, 0), os_)
			UI.orbFruit = makeFruit(UI.Orb, 20, 51)
			UI.orbFruit.grad.Color = ColorSequence.new(C.cyan, C.purple)
			clampOrb()
			makeDraggable(UI.Orb,
				function() return orbPos.x, orbPos.y end,
				function(x, y) orbPos.moved = true; orbPos.x, orbPos.y = x, y; clampOrb() end,
				function() setVisible(not state.visible) end)
		end)
	end

	bind(gui:GetPropertyChangedSignal("AbsoluteSize"), layout)

	-- ANIMATION LOOP
	local T, partAcc, starAcc, boltAcc, shineAcc, waveAcc, frameAcc = 0, 0, 0, 0, 0, 0, 0
	bind(RunService.Heartbeat, function(dt)
		if not alive or not state.visible then return end
		frameAcc += dt
		if frameAcc < STEP then return end
		local d = frameAcc
		frameAcc = 0
		T += d

		UI.borderGrad.Rotation = (T * 55) % 360
		local wave = math.sin(T * 1.4)
		UI.brandGrad.Offset = Vector2.new(wave * 0.35, 0)
		UI.footerGrad.Offset = Vector2.new(-wave * 0.35, 0)
		UI.headFruit.body.Rotation = math.sin(T * 2) * 8
		if UI.orbGrad and UI.Orb then UI.orbGrad.Rotation = (T * 90) % 360 end

		if state.minimized then return end
		if state.enabled then UI.refreshGrad.Offset = Vector2.new(math.sin(T * 1.2) * 0.25, 0) end

		for _, L in ipairs(waves) do
			local span = #L.dots * L.gap
			for i, dot in ipairs(L.dots) do
				local x = ((i - 1) * L.gap + T * L.sp) % span - L.gap
				local edge = math.clamp(math.min(x, CARD_W - x) / 26, 0, 1)
				dot.Position = UDim2.fromOffset(x, L.y + math.sin(T * 2.2 + i * 0.9 + L.ph) * 2.5)
				dot.BackgroundTransparency = 1 - (1 - L.tr) * edge
			end
		end

		if state.status == "Scanning" then
			UI.RadarSweep.Rotation = (T * 300) % 360
			UI.ScanLine.Position = UDim2.new(0, 0, (T * 0.85) % 1.1, 0)
			UI.Spinner.Rotation = (T * 540) % 360
			UI.StatusDot.BackgroundTransparency = 0.5 + 0.5 * math.sin(T * 10)
		end

		local col = state.fx
		if col then
			local s = math.sin(T * 3)
			UI.GlowRing.BackgroundTransparency = 0.8 + 0.08 * s
			UI.ringStroke.Transparency = 0.15 + 0.25 * s
			UI.glowScale.Scale = 1 + 0.05 * s
			UI.haloScale.Scale = 1 + 0.08 * math.sin(T * 2)
			UI.cardStroke.Transparency = 0.15 + 0.2 * s
			UI.bigFruit.body.Rotation = math.sin(T * 1.6) * 6

			if state.rays then
				local lvl = state.fxLevel
				local baseT = (lvl == 1 and 0.75) or (lvl == 2 and 0.5) or 0.35
				for i, r in ipairs(rays) do
					local a = math.rad(i * (360 / #rays) + T * (lvl == 3 and 40 or 25))
					local rad = 46 + math.sin(T * 3 + i) * 3
					r.Position = UDim2.fromOffset(ICON_X + math.sin(a) * rad, ICON_Y - math.cos(a) * rad)
					r.Rotation = math.deg(a)
					r.BackgroundTransparency = baseT + 0.15 * math.sin(T * 4 + i)
				end
			end

			local lvl = state.fxLevel
			if lvl >= 2 then
				partAcc += d
				if partAcc > (lvl == 3 and 0.08 or 0.14) then
					partAcc = 0
					spawnParticle((lvl == 3 and math.random() < 0.35) and C.gold or col)
				end
				waveAcc += d
				if waveAcc > (lvl == 3 and 1.4 or 2.2) then waveAcc = 0; spawnShockwave(col) end
			end
			if lvl >= 1 then
				starAcc += d
				if starAcc > (lvl == 3 and 0.3 or lvl == 2 and 0.5 or 1.1) then
					starAcc = 0
					spawnStar(lvl >= 2 and C.gold or col)
				end
			end
			if lvl == 3 then
				boltAcc += d
				if boltAcc > 2 then boltAcc = math.random() * 0.8; spawnLightning(col) end
			end
			shineAcc += d
			if shineAcc > 3.4 then shineAcc = 0; shineSweep() end
		end
	end)

	showEmpty("No Fruit Detected", "Turn on the predictor to scan.")
	setButtonEnabled(false)
	layout()
end

