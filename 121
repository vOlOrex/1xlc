local function injectPreviewModel(fruitData)
	local mdl = clonedModelsMap[fruitData.StorageName]
	local fruitPart = mdl and mdl:FindFirstChild("Fruit")
	local itemId = fruitData.ItemId
	if not fruitPart or not itemId then return end
	local ok, labelName = pcall(function() return ItemConfig.tryGet(itemId).Index.DebugLabel end)
	if not ok or type(labelName) ~= "string" or labelName == "" then
		labelName = fruitData.StorageName .. " [PhysicalMoveset-" .. tostring(itemId) .. "]"
	end
	local container = playerGui:FindFirstChild("__ReplicatedSpinnerInstances")
	if not container then
		container = Instance.new("ScreenGui")
		container.Name = "__ReplicatedSpinnerInstances"
		container.ResetOnSpawn = false
		container.Parent = playerGui
	end
	local old = container:FindFirstChild(labelName)
	if old then old:Destroy() end
	local clone = fruitPart:Clone()
	for _, d in ipairs(clone:GetDescendants()) do
		if d:IsA("LuaSourceContainer") then d:Destroy() end
	end
	clone.Name = labelName
	local rp = clone:FindFirstChild("RootPart")
	if rp and not rp:IsA("BasePart") then rp = nil end
	clone.PrimaryPart = rp or clone.PrimaryPart or clone:FindFirstChildWhichIsA("BasePart", true)
	if not clone.PrimaryPart then clone:Destroy(); return end
	clone:SetAttribute("ItemId", itemId)
	clone:SetAttribute("__Size", clone:GetExtentsSize())
	clone.Parent = container
	task.spawn(function()
		local Spinner = require(ReplicatedStorage.Controllers.UI.Spinner)
		local t0 = tick()
		while tick() - t0 < 5 and not Spinner:IsOpen() do task.wait(0.1) end
		while tick() - t0 < 600 and Spinner:IsOpen() do task.wait(0.5) end
		if clone.Parent then clone:Destroy() end
	end)
end

-- اختيار الفاكهة المتوقعة القادمة
local function rollNextFruit(useLuck)
	local pool = (useLuck and #LoadedMythicalPool > 0) and LoadedMythicalPool or (useLuck and MythicalPool or NormalPool)
	return pool[math.random(1, #pool)]
end

-- تنفيذ اللفة الفعلية في Gacha اللعبة بنفس الفاكهة المتوقعة
local function executeGachaSpin(useLuck, chosenFruit)
	local targetFruit = chosenFruit or rollNextFruit(useLuck)
	task.spawn(function()
		pcall(function()
			require(ReplicatedStorage.Controllers.UI.Spinner):Open({ targetFruit }, AllFruits, "ZiolesGacha")
		end)

		local storageName = targetFruit.StorageName
		local primeExists = getPrimeTool(storageName) ~= nil

		if useLuck and primeExists then
			-- وضع الفاكهة الحقيقية إذا كانت في المخزن
			local primeTool = getPrimeTool(storageName)
			local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildWhichIsA("Humanoid")
			if hum and primeTool then hum:EquipTool(primeTool) end
			task.wait(1)
			if hum and primeTool then
				local handle = primeTool:FindFirstChild("Handle")
				if handle then
					local cf = handle.CFrame
					hum:UnequipTools()
					task.wait(0.1)
					primeTool.CanBeDropped = true
					primeTool.Parent = workspace
					handle.CFrame = cf * CFrame.new(0, 0, -1.5)
					handle.CanCollide = true
					task.wait(2)
					if primeTool.Parent == workspace then primeTool.Parent = LocalPlayer.Backpack end
				end
			end
		elseif useLuck and loadedStorageMap[storageName] then
			-- الوضع المنسوخ التفاعلي
			local template = clonedModelsMap[storageName]
			if template then
				local clone = template:Clone()
				clone.Name = targetFruit.DisplayName .. " Fruit"
				clone:SetAttribute("X10Fake", true)
				setupFakeToolInteractions(clone, storageName, targetFruit.DisplayName)
				clone.Parent = LocalPlayer.Backpack
				clone.Equipped:Connect(function()
					local f = clone:FindFirstChild("Fruit")
					local ac = f and f:FindFirstChildWhichIsA("AnimationController")
					local anim = ac and ac:FindFirstChildWhichIsA("Animator")
					local aObj = f and f:FindFirstChildWhichIsA("Animation", true)
					if anim and aObj then
						local tr = anim:LoadAnimation(aObj)
						tr.Looped = true
						tr:Play()
					end
				end)
			end
		end

		pcall(injectPreviewModel, targetFruit)
	end)
end

