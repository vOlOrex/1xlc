local function shake(power)
	task.spawn(function()
		for i = 1, 7 do
			local p = math.max(1, math.floor(power * (1 - i / 8)))
			Pop.Position = UDim2.fromOffset(math.random(-p, p), math.random(-p, p))
			task.wait(0.03)
		end
		Pop.Position = UDim2.fromOffset(0, 0)
	end)
end

