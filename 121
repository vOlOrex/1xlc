task.spawn(function()
	local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
	local owned = getOwnedMythicals()
	local mythList = {}
	for _, item in pairs(owned) do
		if item.Type == "Blox Fruit" and (item.Rarity or 0) == 4 then
			table.insert(mythList, item)
		end
	end

	local total = #mythList
	loadSub.Text = string.format("Found %d mythical items", total)

	for i, item in ipairs(mythList) do
		local sName = item.Name or (item.DisplayName .. "-" .. item.DisplayName)
		local dName = item.DisplayName or sName
		loadTitle.Text = string.format("Loading fruit models %d/%d", i, total)
		loadSub.Text = "Models only, your items stay safe."
		tween(barFill, 0.2, { Size = UDim2.fromScale((i - 1) / math.max(total, 1), 1) })

		if replicatedFruits:FindFirstChild(sName) then
			loadedStorageMap[sName] = true
		else
			pcall(function() commF:InvokeServer("LoadFruit", sName) end)
			local toolFound = nil
			local t0 = tick()
			while tick() - t0 < 3 do
				local t = LocalPlayer.Backpack:FindFirstChild(dName .. " Fruit") or LocalPlayer.Backpack:FindFirstChild(item.Name .. " Fruit")
				if t then toolFound = t; break end
				task.wait(0.1)
			end

			if toolFound then
				local clone = toolFound:Clone()
				clone.Name = sName
				clone.Parent = replicatedFruits
				loadedStorageMap[sName] = true
				pcall(function()
					local hum = char:FindFirstChildWhichIsA("Humanoid")
					if hum then
						hum:EquipTool(toolFound)
						task.wait(1)
						local wChar = workspace.Characters:FindFirstChild(LocalPlayer.Name)
						local wTool = wChar and (wChar:FindFirstChild(dName .. " Fruit") or wChar:FindFirstChild(item.Name .. " Fruit"))
						if wTool then
							local mdlClone = wTool:Clone()
							mdlClone.Name = sName
							local fPart = mdlClone:FindFirstChild("Fruit")
							local rp = fPart and fPart:FindFirstChild("RootPart")
							if rp then
								for _, desc in ipairs(fPart:GetDescendants()) do
									if desc:IsA("BasePart") and desc ~= rp and not desc:FindFirstChildWhichIsA("WeldConstraint") then
										local wc = Instance.new("WeldConstraint")
										wc.Part0 = rp; wc.Part1 = desc; wc.Parent = desc
									end
								end
							end
							clonedModelsMap[sName] = mdlClone
							commF:InvokeServer("StoreFruit", sName, wTool)
						end
					end
				end)
				task.wait(0.8)
			end
		end
	end

	for _, f in ipairs(MythicalPool) do
		if loadedStorageMap[f.StorageName] then
			table.insert(LoadedMythicalPool, f)
		end
	end

	if loadingGui then loadingGui:Destroy() end
	buildUI()
end)
