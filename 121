	local function fxCount() return #UI.FX:GetChildren() end

	local function spawnParticle(color, fromX, fromY, dx, dy, life)
		if fxCount() > MAX_FX then return end
		local sz = math.random(3, 6)
		local p = frame({ AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(sz, sz),
			Position = UDim2.fromOffset(fromX or math.random(24, CARD_W - 24), fromY or math.random(110, CARD_H - 10)),
			BackgroundColor3 = (math.random() < 0.3) and C.white or color, BackgroundTransparency = 0.05, ZIndex = 5, Parent = UI.FX }, { circle() })
		tween(p, life or math.random(12, 20) / 10, {
			Position = p.Position + UDim2.fromOffset(dx or math.random(-14, 14), dy or -math.random(50, 100)),
			BackgroundTransparency = 1, Size = UDim2.fromOffset(1, 1),
		}, Enum.EasingStyle.Sine).Completed:Connect(function() p:Destroy() end)
	end

	local function spawnStar(color)
		if fxCount() > MAX_FX then return end
		local s = frame({ AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(12, 12), BackgroundTransparency = 1,
			Position = UDim2.fromOffset(math.random(12, CARD_W - 12), math.random(12, CARD_H - 30)), Rotation = math.random(0, 45),
			ZIndex = 5, Parent = UI.FX })
		local sc = new("UIScale", { Scale = 0.2, Parent = s })
		local bars = {
			frame({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(1, 0, 0, 2),
				BackgroundColor3 = color, BackgroundTransparency = 1, Parent = s }, { circle() }),
			frame({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0, 2, 1, 0),
				BackgroundColor3 = C.white, BackgroundTransparency = 1, Parent = s }, { circle() }),
		}
		tween(sc, 0.35, { Scale = 1.2 }, Enum.EasingStyle.Back)
		for _, b in ipairs(bars) do tween(b, 0.35, { BackgroundTransparency = 0 }) end
		task.delay(0.4, function()
			if not s.Parent then return end
			tween(sc, 0.5, { Scale = 0 })
			for _, b in ipairs(bars) do tween(b, 0.5, { BackgroundTransparency = 1 }) end
			task.delay(0.55, function() s:Destroy() end)
		end)
	end

	local function spawnShockwave(color)
		local ring = frame({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(ICON_X, ICON_Y), Size = UDim2.fromOffset(72, 72),
			BackgroundTransparency = 1, ZIndex = 5, Parent = UI.FX }, { circle() })
		local st = attach(stroke(color, 3, 0.1), ring)
		local sc = new("UIScale", { Parent = ring })
		tween(sc, 0.8, { Scale = 2.4 }, Enum.EasingStyle.Quad)
		tween(st, 0.8, { Transparency = 1, Thickness = 1 }).Completed:Connect(function() ring:Destroy() end)
	end

	local function spawnLightning(color)
		local ang = math.random() * math.pi * 2
		local x, y = ICON_X + math.cos(ang) * 40, ICON_Y + math.sin(ang) * 40
		local parts = {}
		for _ = 1, 4 do
			local len = math.random(9, 16)
			local a = ang + (math.random() - 0.5) * 1.6
			local nx, ny = x + math.cos(a) * len, y + math.sin(a) * len
			local mid = UDim2.fromOffset((x + nx) / 2, (y + ny) / 2)
			table.insert(parts, frame({ AnchorPoint = Vector2.new(0.5, 0.5), Position = mid, Size = UDim2.fromOffset(len + 2, 7),
				Rotation = math.deg(a), BackgroundColor3 = color, BackgroundTransparency = 0.5, ZIndex = 5, Parent = UI.FX }, { circle() }))
			table.insert(parts, frame({ AnchorPoint = Vector2.new(0.5, 0.5), Position = mid, Size = UDim2.fromOffset(len + 2, 2),
				Rotation = math.deg(a), BackgroundColor3 = C.white, ZIndex = 5, Parent = UI.FX }))
			x, y = nx, ny
		end
		UI.cardTint.BackgroundTransparency = 0.75
		tween(UI.cardTint, 0.35, { BackgroundTransparency = 0.9 })
		for _, p in ipairs(parts) do tween(p, 0.3, { BackgroundTransparency = 1 }).Completed:Connect(function() p:Destroy() end) end
