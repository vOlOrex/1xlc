local alive, conns = true, {}
local function bind(signal, fn) local c = signal:Connect(fn); table.insert(conns, c); return c end

local function new(class, props, children)
	local o = Instance.new(class)
	local parent
	for k, v in pairs(props or {}) do if k == "Parent" then parent = v else o[k] = v end end
	for _, ch in ipairs(children or {}) do ch.Parent = o end
	if parent then o.Parent = parent end
	return o
end
local function corner(r) return new("UICorner", { CornerRadius = UDim.new(0, r) }) end
local function circle() return new("UICorner", { CornerRadius = UDim.new(1, 0) }) end
local function stroke(color, thick, trans)
	return new("UIStroke", { Color = color, Thickness = thick or 1, Transparency = trans or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end
local function textStroke(color, thick)
	return new("UIStroke", { Color = color, Thickness = thick or 1.5, ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual })
end
local function grad(colors, rot)
	local kp = {}
	for i, col in ipairs(colors) do kp[i] = ColorSequenceKeypoint.new((i - 1) / math.max(#colors - 1, 1), col) end
	return new("UIGradient", { Color = ColorSequence.new(kp), Rotation = rot or 0 })
end
local function tween(o, t, props, style, dir)
	local tw = TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), props)
	tw:Play(); return tw
end
local function label(props, children)
	props.BackgroundTransparency = 1
	props.Font = props.Font or F_REG
	props.TextSize = props.TextSize or 12
	props.TextColor3 = props.TextColor3 or C.text
	return new("TextLabel", props, children)
end
local function frame(props, children)
	if props.BorderSizePixel == nil then props.BorderSizePixel = 0 end
	return new("Frame", props, children)
end
local function fadeEdges(mid)
	return NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, mid or 0), NumberSequenceKeypoint.new(1, 1) })
end

-- Drawn "devil fruit": round fruit + swirl pattern + stem + leaf
local SWIRL_T = NumberSequence.new({
	NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(0.55, 0.1),
	NumberSequenceKeypoint.new(0.6, 1), NumberSequenceKeypoint.new(1, 1) })
local function makeFruit(parent, size, z, pos)
	local body = frame({ AnchorPoint = Vector2.new(0.5, 0.5), Position = pos or UDim2.new(0.5, 0, 0.5, size * 0.06),
		Size = UDim2.fromOffset(size, size), BackgroundColor3 = C.white, ZIndex = z, Parent = parent }, { circle() })
	local g = grad({ C.cyan, C.blue }, 135); g.Parent = body
	local outline = stroke(C.ink, math.max(1, size / 26), 0.1); outline.Parent = body
	local swirls = {}
	for i, s in ipairs({ { 0.66, -0.06, 0.02, 40 }, { 0.4, 0.1, 0.1, 160 }, { 0.2, -0.04, 0.16, 280 } }) do
		local ring = frame({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5 + s[2], 0.5 + s[3]),
			Size = UDim2.fromScale(s[1], s[1]), BackgroundTransparency = 1, ZIndex = z + 1, Parent = body }, { circle() })
		local st = stroke(C.ink, math.max(1, size / 22), 0.35); st.Parent = ring
		new("UIGradient", { Rotation = s[4], Transparency = SWIRL_T, Parent = st })
		swirls[i] = st
	end
	frame({ Position = UDim2.fromScale(0.18, 0.14), Size = UDim2.fromScale(0.26, 0.16), Rotation = -30,
		BackgroundColor3 = C.white, BackgroundTransparency = 0.45, ZIndex = z + 2, Parent = body }, { circle() })
	frame({ AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 0, size * 0.08), Size = UDim2.fromOffset(math.max(2, size * 0.07), size * 0.2),
		Rotation = 12, BackgroundColor3 = Color3.fromRGB(70, 45, 25), ZIndex = z + 2, Parent = body }, { corner(2) })
	frame({ AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0.5, 1, 0, size * 0.04), Size = UDim2.fromOffset(size * 0.3, size * 0.15),
		Rotation = -22, BackgroundColor3 = Color3.fromRGB(70, 220, 120), ZIndex = z + 2, Parent = body }, { circle(), stroke(C.ink, 1, 0.3) })
	return { body = body, grad = g, swirls = swirls }
end
local function paintFruit(f, rarity)
	local info = RARITY[rarity] or RARITY.Unknown
	f.grad.Color = ColorSequence.new(info.color:Lerp(C.white, 0.25), info.color:Lerp(info.dark, 0.35))
	for _, s in ipairs(f.swirls) do s.Color = info.dark end
end

