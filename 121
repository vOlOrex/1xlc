local function getSprite(fruitName)
	if not ItemId or not ItemConfig then return nil end
	local str = fruitName .. "-" .. fruitName
	local ok, res = pcall(function() return ItemId.getId(str, "PhysicalMoveset"):asNullable() end)
	if not ok or not res then return nil end
	local id = type(res) == "table" and (res.ItemId or res.Id) or res
	local ok2, cfg = pcall(function() return ItemConfig.tryGet(id) end)
	if ok2 and type(cfg) == "table" and cfg.Display and cfg.Display.Sprite then
		return cfg.Display.Sprite
	end
	return nil
end

local function getItemIdNum(fruitName)
	if not ItemId then return nil end
