	local function runPrediction(forceNewPick)
		if not state.enabled or state.busy then return end
		state.busy = true
		state.token += 1
		local my = state.token

		clearFX()
		setStatus("Scanning")
		setButtonLoading(true)
		showView("Scan")
		UI.ProgFill.Size = UDim2.fromScale(0, 1)
		tween(UI.ProgFill, CONFIG.ScanDuration, { Size = UDim2.fromScale(0.9, 1) }, Enum.EasingStyle.Sine)

		local t0 = os.clock()
		local res, err = fetchShopPrediction(forceNewPick)
		local left = CONFIG.ScanDuration - (os.clock() - t0)
		if left > 0 then task.wait(left) end
		if not alive or my ~= state.token then return end
		tween(UI.ProgFill, 0.15, { Size = UDim2.fromScale(1, 1) })
		task.wait(0.15)
		if not alive or my ~= state.token then return end

		if res then
			if CONFIG.SpinAnimation and not spinReel(res, my) then return end
			state.busy = false
			setButtonLoading(false)
			reveal(res); setStatus("Detected", res.rarity); stamp()
			return
		end
		state.busy = false
		setButtonLoading(false)
		state.current = nil
		showEmpty("Prediction Unavailable", err or "Error", "error")
		setStatus("Error"); stamp("Last try failed")
	end

