local logBuf = {}
local function dbg(...)
	local parts = table.pack(...)
	for i = 1, parts.n do parts[i] = tostring(parts[i]) end
	local line = table.concat(parts, " ", 1, parts.n)
	logBuf[#logBuf + 1] = line
	if #logBuf > 80 then table.remove(logBuf, 1) end
	if CONFIG.Debug then print(TAG, line) end
end
ENV.__FruitSpinPredictorLog = logBuf

local function formatComma(num)
	if TextUtil and type(TextUtil.commaValue) == "function" then
		local ok, res = pcall(TextUtil.commaValue, num)
		if ok then return res end
	end
	local formatted = tostring(math.floor(tonumber(num) or 0))
	while true do
		local k
		formatted, k = string.gsub(formatted, "^(-?%d+)(%d%d%d)", "%1,%2")
		if k == 0 then break end
	end
	return formatted
end

