local currentPrice = 0
local hookActive = false
local overrideText = nil
local hookedLabels = {}
local hookedProps = {}
local greenTheme = { btn = Color3.fromRGB(50, 185, 65), stroke = Color3.fromRGB(27, 112, 36), trans = Color3.fromRGB(76, 214, 90) }

local function isAnyBypassOn() return BypassState.bypassCash or BypassState.bypassTime end

local function lockProp(obj, prop, val)
	if hookedProps[obj] then return end
	local rec = { prop = prop, orig = obj[prop], want = val }
	rec.conn = obj:GetPropertyChangedSignal(prop):Connect(function()
		if obj[prop] ~= rec.want then rec.orig = obj[prop]; obj[prop] = rec.want end
	end)
	hookedProps[obj] = rec
	obj[prop] = val
end

local function unlockAllProps()
	for k, v in pairs(hookedProps) do
		v.conn:Disconnect()
		if k.Parent then k[v.prop] = v.orig end
	end
	hookedProps = {}
end

local function paintPurchaseBtnGreen(btn)
	lockProp(btn, "BackgroundColor3", greenTheme.btn)
	local st = btn:FindFirstChildOfClass("UIStroke")
	if st then lockProp(st, "Color", greenTheme.stroke) end
	local tr = btn:FindFirstChild("Trans")
	if tr and tr:IsA("Frame") then lockProp(tr, "BackgroundColor3", greenTheme.trans) end
end

local function lockLabelText(lbl)
	if hookedLabels[lbl] then return end
	local rec = { orig = lbl.Text }
	rec.conn = lbl:GetPropertyChangedSignal("Text"):Connect(function()
		if overrideText then
			if lbl.Text ~= overrideText then rec.orig = lbl.Text; lbl.Text = overrideText end
		else
			rec.orig = lbl.Text
		end
	end)
	hookedLabels[lbl] = rec
	if overrideText then lbl.Text = overrideText end
end

local function setOverrideText(txt)
	overrideText = txt
	for k, v in pairs(hookedLabels) do
		if k.Parent then k.Text = txt or v.orig end
	end
end

local function resetHooks()
	overrideText = nil
	for k, v in pairs(hookedLabels) do
		v.conn:Disconnect()
		if k.Parent then k.Text = v.orig end
	end
	hookedLabels = {}
	unlockAllProps()
end

local function attachFakeOverlay(btn)
	local old = btn:FindFirstChild("FakeOverlay")
	if old then old:Destroy() end
	local clicked = false
	local overlay = Instance.new("TextButton")
	overlay.Name = "FakeOverlay"
	overlay.Size = UDim2.fromScale(1, 1)
	overlay.BackgroundTransparency = 1
	overlay.Text = ""
	overlay.ZIndex = 100
	overlay.Parent = btn

	overlay.Activated:Connect(function()
		if clicked then return end
		if not BypassState.bypassCash and LocalPlayer.Data.Beli.Value < currentPrice then
			setOverrideText(("Need $%s more"):format(TextUtil.commaValue(currentPrice - LocalPlayer.Data.Beli.Value)))
			task.delay(2, function()
				if overlay.Parent then setOverrideText(BypassState.bypassCash and "FREE" or nil) end
			end)
			return
		end
		clicked = true
		task.delay(0.5, function()
			hookActive = false
			overlay:Destroy()
			pcall(function() GachaWindow:Close() end)
			task.delay(0.5, function()
				local ok, isOpen = pcall(function() return GachaWindow:IsOpen() end)
				local win = playerGui:FindFirstChild("ZiolesGacha_Window")
				if win and win.Enabled and (not ok or isOpen) then win.Enabled = false end
			end)
			-- نستخدم الفاكهة المتوقعة في الـ UI أو نولد واحدة جديدة
			executeGachaSpin(BypassState.boostLuck, nextPredictedFruit)
			-- تجهيز التوقع القادم تلقائياً
			nextPredictedFruit = rollNextFruit(BypassState.boostLuck)
			if ENV.__RefreshPredictorCard then task.spawn(ENV.__RefreshPredictorCard) end
		end)
	end)

	for _, d in ipairs(btn:GetDescendants()) do
		if d:IsA("TextLabel") then lockLabelText(d) end
	end
	if isAnyBypassOn() then paintPurchaseBtnGreen(btn) end
end

local function scanGachaElement(el)
	if el.Name == "PurchaseButton" and el:IsA("GuiButton") then
		if el:FindFirstAncestor("ZiolesGacha_Window") and not el:FindFirstChild("FakeOverlay") then
			attachFakeOverlay(el)
		end
	elseif el:IsA("TextLabel") and el:FindFirstAncestor("PurchaseButton") and el:FindFirstAncestor("ZiolesGacha_Window") then
		lockLabelText(el)
	elseif isAnyBypassOn() and el.Parent and el.Parent.Name == "PurchaseButton" and el:FindFirstAncestor("ZiolesGacha_Window") then
		if el:IsA("UIStroke") then lockProp(el, "Color", greenTheme.stroke)
		elseif el.Name == "Trans" and el:IsA("Frame") then lockProp(el, "BackgroundColor3", greenTheme.trans) end
	end
end

local descConn = playerGui.DescendantAdded:Connect(function(d)
	if hookActive then scanGachaElement(d) end
end)

GachaWindow.Open = function(self, gachaType, priceObj, ...)
	if gachaType == "ZiolesGacha" then
		resetHooks()
		hookActive = false
		if BypassState.boostLuck or BypassState.bypassCash or BypassState.bypassTime then
			currentPrice = type(priceObj) == "table" and tonumber(priceObj.Value) or 0
			hookActive = true
			overrideText = BypassState.bypassCash and "FREE" or nil
			local win = playerGui:FindFirstChild("ZiolesGacha_Window")
			if win then
				for _, d in ipairs(win:GetDescendants()) do
					if d.Name == "FakeOverlay" then d:Destroy() end
				end
				for _, d in ipairs(win:GetDescendants()) do scanGachaElement(d) end
			end
		end
	end

	if gachaType == "ZiolesGacha" and hookActive then
		for _, delaySec in ipairs({ 0, 0.05, 0.15, 0.3, 0.6 }) do
			task.delay(delaySec, function()
				if not hookActive then return end
				local win = playerGui:FindFirstChild("ZiolesGacha_Window")
				if win then
					for _, d in ipairs(win:GetDescendants()) do scanGachaElement(d) end
				end
			end)
		end
	end

	local args = table.pack(...)
	args.n = 4 + args.n - 1
	table.move(args, 1, args.n, 4, args)
	args[1] = self; args[2] = gachaType; args[3] = priceObj
	return origGachaOpen(table.unpack(args, 1, args.n))
end

