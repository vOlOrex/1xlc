	local function spinReel(final, my)
		showView("Reel")
		UI.slotScale.Scale = 1
		UI.slotStroke.Color = C.gold
		local steps, start = 16, math.random(#REEL_LIST)
		for i = 1, steps do
			if not alive or my ~= state.token then return false end
			local isLast = (i == steps)
			local pick = isLast and final or REEL_LIST[(start + i) % #REEL_LIST + 1]
			UI.ReelName.Text = pick.name
			UI.ReelName.TextColor3 = rarityInfo(pick.rarity).color
			applyReelFruitVisual(pick.name, pick.rarity, isLast and final.sprite or nil)
			UI.ReelName.Position = UDim2.fromOffset(78, -10)
			tween(UI.ReelName, 0.07, { Position = UDim2.fromOffset(78, 0) })
			task.wait(0.025 + (i / steps) ^ 3 * 0.18)
		end
		local col = rarityInfo(final.rarity).color
		UI.slotStroke.Color = col
		UI.slotScale.Scale = 1.1
		tween(UI.slotScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
		task.wait(0.35)
		return alive and my == state.token
	end

