		end
	end

	for _, item in ipairs(mythList) do
		if not alive then break end
		local sName = item.Name or (item.DisplayName .. "-" .. item.DisplayName)
		local dName = item.DisplayName or sName

		if replicatedFruits and replicatedFruits:FindFirstChild(sName) then
			loadedStorageMap[sName] = true
		elseif commF then
			pcall(function() commF:InvokeServer("LoadFruit", sName) end)
			local toolFound = nil
			local t0 = tick()
			while tick() - t0 < 3 do
				local bp = LocalPlayer:FindFirstChild("Backpack")
				local t = bp and (bp:FindFirstChild(dName .. " Fruit") or bp:FindFirstChild(item.Name .. " Fruit"))
				if t then toolFound = t; break end
				task.wait(0.1)
			end

			if toolFound then
				if replicatedFruits then
					local clone = toolFound:Clone()
					clone.Name = sName
					clone.Parent = replicatedFruits
				end
				loadedStorageMap[sName] = true
				pcall(function()
					local hum = char:FindFirstChildWhichIsA("Humanoid")
					if hum then
						hum:EquipTool(toolFound)
						task.wait(1)
						local wChar = workspace:FindFirstChild("Characters") and workspace.Characters:FindFirstChild(LocalPlayer.Name)
						local wTool = wChar and (wChar:FindFirstChild(dName .. " Fruit") or wChar:FindFirstChild(item.Name .. " Fruit"))
						if wTool then
							local mdlClone = wTool:Clone()
							mdlClone.Name = sName
							local fPart = mdlClone:FindFirstChild("Fruit")
							local rp = fPart and fPart:FindFirstChild("RootPart")
							if rp then
								for _, desc in ipairs(fPart:GetDescendants()) do
									if desc:IsA("BasePart") and desc ~= rp and not desc:FindFirstChildWhichIsA("WeldConstraint") then
										local wc = Instance.new("WeldConstraint")
										wc.Part0 = rp; wc.Part1 = desc; wc.Parent = desc
									end
								end
							end
							clonedModelsMap[sName] = mdlClone
							commF:InvokeServer("StoreFruit", sName, wTool)
						end
					end
				end)
				task.wait(0.8)
			end
		end
	end

	for _, f in ipairs(MythicalPool) do
		if loadedStorageMap[f.StorageName] then
			table.insert(LoadedMythicalPool, f)
		end
	end
end)
