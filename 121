		local vp = viewport()
		local fit = math.min((vp.X - 16) / W, (vp.Y - 16) / H)
		local s = math.clamp(math.min(1, fit), 0.35, 1)
		UI.rootScale.Scale = s
		local h = state.minimized and HEADER or H
		UI.Anchor.Size = UDim2.fromOffset(W * s, h * s)
		clampPos()
