local function snapshot(root)
	local list = {}
	for _, o in ipairs(root:GetDescendants()) do
		if o:IsA("GuiObject") then
			local e = { o = o, p = { BackgroundTransparency = o.BackgroundTransparency } }
			if o:IsA("TextLabel") or o:IsA("TextButton") then e.p.TextTransparency = o.TextTransparency end
			if o:IsA("ImageLabel") then e.p.ImageTransparency = o.ImageTransparency end
			table.insert(list, e)
		elseif o:IsA("UIStroke") then
			table.insert(list, { o = o, p = { Transparency = o.Transparency } })
		end
	end
	return list
