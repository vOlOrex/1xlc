local hookedProps = {}

local function isAnyBypassActive() return gachaFlags.bypassCash or gachaFlags.bypassTime end

local function lockProp(arg, arg2, arg3)
	if hookedProps[arg] then return end
	local tbl15 = { prop = arg2, orig = arg[arg2], want = arg3 }
	tbl15.conn = arg:GetPropertyChangedSignal(arg2):Connect(function()
		if arg[arg2] ~= tbl15.want then
			tbl15.orig = arg[arg2]
			arg[arg2] = tbl15.want
		end
	end)
	hookedProps[arg] = tbl15
	arg[arg2] = arg3
end

local function unlockAllProps()
	for k, v5 in pairs(hookedProps) do
		v5.conn:Disconnect()
		if k.Parent then k[v5.prop] = v5.orig end
	end
	hookedProps = {}
end

local function styleGreenButton(arg)
	lockProp(arg, "BackgroundColor3", greenColors.btn)
	local uiStroke = arg:FindFirstChildOfClass("UIStroke")
	if uiStroke then lockProp(uiStroke, "Color", greenColors.stroke) end
	local trans = arg:FindFirstChild("Trans")
	if trans and trans:IsA("Frame") then lockProp(trans, "BackgroundColor3", greenColors.trans) end
end

local function hookButtonText(arg)
	if hookedLabels[arg] then return end
	local tbl15 = { orig = arg.Text }
	tbl15.conn = arg:GetPropertyChangedSignal("Text"):Connect(function()
		if overrideText then
			if arg.Text ~= overrideText then tbl15.orig = arg.Text; arg.Text = overrideText end
		else tbl15.orig = arg.Text end
	end)
	hookedLabels[arg] = tbl15
	if overrideText then arg.Text = overrideText end
end

local function setButtonOverrideText(text2)
	overrideText = text2
	for k, v5 in pairs(hookedLabels) do if k.Parent then k.Text = text2 or v5.orig end end
end

local function resetGachaHooks()
	overrideText = nil
	for k, v5 in pairs(hookedLabels) do
		v5.conn:Disconnect()
		if k.Parent then k.Text = v5.orig end
	end
	hookedLabels = {}
	unlockAllProps()
end

