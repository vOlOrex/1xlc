local function setEnabled(on)
	state.enabled = on
	tween(Knob, 0.3, { Position = on and UDim2.new(1, -18, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
		BackgroundColor3 = on and C.white or Color3.fromRGB(185, 192, 212) }, Enum.EasingStyle.Back)
	switchGrad.Enabled = on
	tween(Switch, 0.25, { BackgroundColor3 = on and C.white or C.off })
	tween(toggleRowStroke, 0.25, { Color = on and C.cyan or C.line })
	toggleSub.Text = on and "ON" or "OFF"
	toggleSub.TextColor3 = on and C.cyan or C.sub
	setButtonEnabled(on)
	if on then
		task.spawn(runPrediction)
	else
		state.token += 1
		state.busy, state.current = false, nil
		setButtonLoading(false)
		showEmpty("No Fruit Detected", "Turn on the predictor to scan.")
		setStatus("Waiting"); stamp("No data yet")
	end
end

