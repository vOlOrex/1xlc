local function getContainer(name)
	if name == "PlayerGui" then
		return LocalPlayer:FindFirstChildOfClass("PlayerGui") or LocalPlayer:WaitForChild("PlayerGui", 10)
	elseif name == "gethui" then
		if typeof(gethui) == "function" then
			local ok, h = pcall(gethui)
			if ok and typeof(h) == "Instance" then return h end
		end
	elseif name == "CoreGui" then
		local ok, cg = pcall(function() return game:GetService("CoreGui") end)
		if ok and typeof(cg) == "Instance" then return cg end
	end
	return nil
end

local function mount(g)
	for _, name in ipairs(CONFIG.ParentOrder) do
		local inst = getContainer(name)
		if inst then
			local ok, err = pcall(function() g.Parent = inst end)
			if ok and g.Parent == inst and g:IsDescendantOf(game) then
				return name
			end
			dbg("could not parent GUI to", name, ok and "(parent not kept)" or err)
			pcall(function() g.Parent = nil end)
		else
			dbg("container unavailable:", name)
		end
	end
	return nil
end

local function cleanupOld()
	for _, name in ipairs({ "PlayerGui", "gethui", "CoreGui" }) do
		local c = getContainer(name)
		if c then
			pcall(function()
				for _, o in ipairs(c:GetChildren()) do
					if o.Name == "FruitSpinPredictor" or o.Name == "FruitSpinPredictor_Error" then o:Destroy() end
				end
			end)
		end
	end
end

local function destroyAll()
	if not alive then return end
	alive = false
	for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
	table.clear(conns)
	if GachaWindow and origGachaOpen then
		pcall(function() GachaWindow.Open = origGachaOpen end)
	end
	if ENV.__FruitSpinPredictorDestroy == destroyAll then ENV.__FruitSpinPredictorDestroy = nil end
	if gui then pcall(function() gui:Destroy() end) end
end

