	------------------------------------------------------------------
	-- ANIMATION LOOP
	------------------------------------------------------------------
	local T, partAcc, starAcc, boltAcc, shineAcc, waveAcc, frameAcc = 0, 0, 0, 0, 0, 0, 0

	local function step(dt)
		T += dt
		UI.borderGrad.Rotation = (T * 55) % 360
		local wave = math.sin(T * 1.4)
		UI.brandGrad.Offset = Vector2.new(wave * 0.35, 0)
		UI.footerGrad.Offset = Vector2.new(-wave * 0.35, 0)
		UI.headFruit.body.Rotation = math.sin(T * 2) * 8
		if UI.orbGrad and UI.Orb then UI.orbGrad.Rotation = (T * 90) % 360 end

		if state.minimized then return end

		if state.enabled then UI.refreshGrad.Offset = Vector2.new(math.sin(T * 1.2) * 0.25, 0) end

		for _, L in ipairs(waves) do
			local span = #L.dots * L.gap
			for i, d in ipairs(L.dots) do
				local x = ((i - 1) * L.gap + T * L.sp) % span - L.gap
				local edge = math.clamp(math.min(x, CARD_W - x) / 26, 0, 1)
				d.Position = UDim2.fromOffset(x, L.y + math.sin(T * 2.2 + i * 0.9 + L.ph) * 2.5)
				d.BackgroundTransparency = 1 - (1 - L.tr) * edge
			end
		end

		if state.status == "Scanning" then
			UI.RadarSweep.Rotation = (T * 300) % 360
			UI.ScanLine.Position = UDim2.new(0, 0, (T * 0.85) % 1.1, 0)
			UI.Spinner.Rotation = (T * 540) % 360
			UI.StatusDot.BackgroundTransparency = 0.5 + 0.5 * math.sin(T * 10)
		end

		local col = state.fx
		if col then
			local s = math.sin(T * 3)
			UI.GlowRing.BackgroundTransparency = 0.8 + 0.08 * s
			UI.ringStroke.Transparency = 0.15 + 0.25 * s
			UI.glowScale.Scale = 1 + 0.05 * s
			UI.haloScale.Scale = 1 + 0.08 * math.sin(T * 2)
			UI.cardStroke.Transparency = 0.15 + 0.2 * s
			UI.bigFruit.body.Rotation = math.sin(T * 1.6) * 6

			if state.rays then
				local lvl = state.fxLevel
				local baseT = (lvl == 1 and 0.75) or (lvl == 2 and 0.5) or 0.35
				for i, r in ipairs(rays) do
					local a = math.rad(i * (360 / #rays) + T * (lvl == 3 and 40 or 25))
					local rad = 46 + math.sin(T * 3 + i) * 3
					r.Position = UDim2.fromOffset(ICON_X + math.sin(a) * rad, ICON_Y - math.cos(a) * rad)
					r.Rotation = math.deg(a)
					r.BackgroundTransparency = baseT + 0.15 * math.sin(T * 4 + i)
				end
			end

			local lvl = state.fxLevel
			if lvl >= 2 then
				partAcc += dt
				if partAcc > (lvl == 3 and 0.08 or 0.14) then
					partAcc = 0
					spawnParticle((lvl == 3 and math.random() < 0.35) and C.gold or col)
				end
				waveAcc += dt
				if waveAcc > (lvl == 3 and 1.4 or 2.2) then waveAcc = 0; spawnShockwave(col) end
			end
			if lvl >= 1 then
				starAcc += dt
				if starAcc > (lvl == 3 and 0.3 or lvl == 2 and 0.5 or 1.1) then
					starAcc = 0
					spawnStar(lvl >= 2 and C.gold or col)
				end
			end
			if lvl == 3 then
				boltAcc += dt
				if boltAcc > 2 then boltAcc = math.random() * 0.8; spawnLightning(col) end
			end
			shineAcc += dt
			if shineAcc > 3.4 then shineAcc = 0; shineSweep() end
		end
	end

	local stepErrors = 0
	local hbConn
	hbConn = bind(RunService.Heartbeat, function(dt)
		if not alive or not state.visible then return end
		frameAcc += dt
		if frameAcc < STEP then return end
		local d = frameAcc
		frameAcc = 0
		local ok, err = pcall(step, d)
		if not ok then
			stepErrors += 1
			if stepErrors == 1 then dbg("animation step error:", err) end
			if stepErrors >= 5 then
				hbConn:Disconnect()
			end
		end
	end)

	task.spawn(function()
		while alive do
			task.wait(1)
			if not alive then break end
			if gui and not gui:IsDescendantOf(game) then
				mount(gui)
			end
		end
	end)

	showEmpty("No Fruit Detected", "Turn on the predictor to scan.")
	setButtonEnabled(false)
	layout()

	local fadeList
	guard("open-fade", function()
		fadeList = snapshot(UI.Holder)
		fadeAll(fadeList, true, 0.45)
		local stagger = { UI.ToggleRow, PillBar, UI.StatusChip, UI.UpdatedLbl, UI.Card, UI.BtnBase, UI.FooterBrand }
		for i, obj in ipairs(stagger) do
			local target = obj.Position
			obj.Position = target + UDim2.fromOffset(0, 12)
			task.delay(0.1 + i * 0.05, function() if alive and obj.Parent then tween(obj, 0.45, { Position = target }) end end)
		end
		local target = UI.Anchor.Position
		UI.Anchor.Position = target + UDim2.fromOffset(0, 24)
		tween(UI.Anchor, 0.5, { Position = target })
		tween(UI.mainScale, 0.5, { Scale = 1 }, Enum.EasingStyle.Back)
	end)
	task.delay(1.2, function()
		if not alive then return end
		if fadeList == nil or UI.Main.BackgroundTransparency > 0.5 then
			if fadeList then restoreAll(fadeList) end
		end
		UI.mainScale.Scale = 1
		layout()
	end)
end

