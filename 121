			local anim = hum and hum:FindFirstChildWhichIsA("Animator")
			if anim then
				local a = Instance.new("Animation")
				a.AnimationId = "rbxassetid://10851812420"
				local track = anim:LoadAnimation(a)
				track.Priority = Enum.AnimationPriority.Action
