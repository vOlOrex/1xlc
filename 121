local function spinReel(final, my)
	showView("Reel")
	slotScale.Scale = 1
	slotStroke.Color = C.gold
	local steps, start = 18, math.random(#REEL_LIST)
	for i = 1, steps do
		if not alive or my ~= state.token then return false end
		-- cosmetic cycle through the fruit list; the last step is the REAL result
		local pick = (i == steps) and final or REEL_LIST[(start + i) % #REEL_LIST + 1]
		ReelName.Text = pick.name
		ReelName.TextColor3 = rarityInfo(pick.rarity).color
		paintFruit(reelFruit, pick.rarity)
		ReelName.Position = UDim2.fromOffset(66, -10)
		tween(ReelName, 0.07, { Position = UDim2.fromOffset(66, 0) })
		task.wait(0.03 + (i / steps) ^ 3 * 0.22)
	end
	local col = rarityInfo(final.rarity).color
	slotStroke.Color = col
	slotScale.Scale = 1.12
	tween(slotScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
	task.wait(0.45)
	return alive and my == state.token
end

local function reveal(data)
	state.current = data
	local info = rarityInfo(data.rarity)
	local col = info.color
	local special = info.fx >= 2
	clearFX()
	state.fx, state.fxLevel, state.rays = col, info.fx, info.fx >= 1

	NameLbl.Text = data.name
	NameLbl.TextColor3 = col
	BadgeText.Text = string.upper(data.rarity)
	BadgeText.TextColor3 = C.white
	Badge.BackgroundColor3 = col
	badgeStroke.Color = special and C.gold or C.ink
	DetailLbl.Text = string.format('Predicted Fruit: <b>%s</b>  |  Rarity: <font color="#%s"><b>%s</b></font>',
		data.name, col:ToHex(), data.rarity)
	GlowRing.BackgroundColor3, ringStroke.Color, Halo.BackgroundColor3 = col, col, col
	iconStroke.Color = special and C.gold or col
	for i, r in ipairs(rays) do r.BackgroundColor3 = (info.fx == 3 and i % 2 == 0) and C.gold or col end
	paintFruit(bigFruit, data.rarity)
	cardTint.BackgroundColor3 = col
	tween(cardTint, 0.5, { BackgroundTransparency = 0.9 })
	tween(cardStroke, 0.4, { Color = special and C.gold or col })
	tween(Haze, 0.5, { BackgroundColor3 = col, BackgroundTransparency = 0.72 })

	if data.icon then
		IconImage.Image, IconImage.Visible, bigFruit.body.Visible = data.icon, true, false
		task.delay(2.5, function()
			if state.current == data and not IconImage.IsLoaded then IconImage.Visible, bigFruit.body.Visible = false, true end
		end)
	else
		IconImage.Visible, bigFruit.body.Visible = false, true
	end

	showView("Result")
	Flash.BackgroundTransparency = special and 0.15 or 0.45
	tween(Flash, 0.6, { BackgroundTransparency = 1 })
	if special then shake(info.fx == 3 and 6 or 4) end

	iconScale.Scale = 0
	tween(iconScale, 0.34, { Scale = 1.18 }, Enum.EasingStyle.Back).Completed:Connect(function()
		tween(iconScale, 0.2, { Scale = 1 }, Enum.EasingStyle.Sine)
	end)
	NameLbl.Position = UDim2.fromOffset(0, 116); NameLbl.TextTransparency = 1
	tween(NameLbl, 0.45, { Position = UDim2.fromOffset(0, 104), TextTransparency = 0 }, Enum.EasingStyle.Back)
	Badge.Position = UDim2.new(0.5, 0, 0, 142); Badge.BackgroundTransparency = 1; BadgeText.TextTransparency = 1
	task.delay(0.12, function()
		tween(Badge, 0.4, { Position = UDim2.new(0.5, 0, 0, 130), BackgroundTransparency = 0 }, Enum.EasingStyle.Back)
		tween(BadgeText, 0.4, { TextTransparency = 0 })
	end)

	spawnShockwave(col)
	if special then task.delay(0.15, function() spawnShockwave(C.gold) end) end
	local n = 10 + info.fx * 5
	for i = 1, n do
		local a = (i / n) * math.pi * 2
		spawnParticle((special and i % 3 == 0) and C.gold or col, ICON_X, ICON_Y,
			math.cos(a) * math.random(50, 80), math.sin(a) * math.random(50, 80), 0.75)
	end
	task.delay(0.3, shineSweep)
end

------------------------------------------------------------------------
-- DATA SOURCE (real data only)
------------------------------------------------------------------------
local function normalize(d, sourceName)
	local fruit = d.fruit or d.Fruit or d.name or d.Name
	if type(fruit) ~= "string" or fruit:match("^%s*$") then return nil, "Prediction data has no fruit name." end
	fruit = fruit:gsub("^%s+", ""):gsub("%s+$", ""):gsub("%s*[Ff]ruit$", "")
	local known = FRUIT_LOOKUP[fruit:lower()]
	local name = known and known.name or fruit
	local rarity = tostring(d.rarity or d.Rarity or (known and known.rarity) or "Unknown")
	rarity = rarity:sub(1, 1):upper() .. rarity:sub(2):lower()
	local icon = d.icon or d.Icon or FRUIT_ICONS[name]
	if type(icon) == "number" then icon = "rbxassetid://" .. icon end
	if type(icon) ~= "string" or icon == "" then icon = nil end
	return { name = name, rarity = rarity, icon = icon, source = sourceName }
end

local function fetchPrediction()
	local src = ENV.FruitPrediction
	if type(src) == "function" then
		local ok, res = pcall(src)
		if not ok then return nil, "Prediction source error: " .. tostring(res):sub(1, 60) end
		src = res
	end
	if type(src) == "string" and src ~= "" then src = { fruit = src } end
	if type(src) == "table" then return normalize(src, "Custom source") end
	if CONFIG.PredictionURL ~= "" then
		local ok, body = pcall(function() return game:HttpGet(CONFIG.PredictionURL) end)
		if not ok or type(body) ~= "string" then return nil, "Couldn't reach the prediction server." end
		local ok2, data = pcall(function() return HttpService:JSONDecode(body) end)
		if not ok2 or type(data) ~= "table" then return nil, "The server sent data the UI can't read." end
		return normalize(data, "Prediction server")
	end
	return nil, "NO_SOURCE"
end

local function fetchWithTimeout(timeout)
	local done, res, err = false, nil, nil
	task.spawn(function()
		local ok, r, e = pcall(fetchPrediction)
		if ok then res, err = r, e else err = "Something went wrong reading the prediction." end
		done = true
	end)
	local t0 = os.clock()
	while not done and os.clock() - t0 < timeout do task.wait(0.05) end
	if not done then return nil, "The prediction source took too long." end
	return res, err
end

local function runPrediction()
	if not state.enabled or state.busy then return end
	state.busy = true
	state.token += 1
	local my = state.token

	clearFX()
	setStatus("Scanning")
	setButtonLoading(true)
	showView("Scan")
	ProgFill.Size = UDim2.fromScale(0, 1)
	tween(ProgFill, CONFIG.ScanDuration, { Size = UDim2.fromScale(0.9, 1) }, Enum.EasingStyle.Sine)

	local t0 = os.clock()
	local res, err = fetchWithTimeout(CONFIG.RequestTimeout)
	local left = CONFIG.ScanDuration - (os.clock() - t0)
	if left > 0 then task.wait(left) end
	if not alive or my ~= state.token then return end
	tween(ProgFill, 0.15, { Size = UDim2.fromScale(1, 1) })
	task.wait(0.18)
	if not alive or my ~= state.token then return end

	if res then
		if CONFIG.SpinAnimation and not spinReel(res, my) then return end
		state.busy = false
		setButtonLoading(false)
		reveal(res); setStatus("Detected", res.rarity); stamp()
		return
	end
	state.busy = false
	setButtonLoading(false)
	state.current = nil
	if err == "NO_SOURCE" then
		showEmpty("No Prediction Source", "Connect a prediction source. No fruit is shown until real data arrives.", "source")
		setStatus("Waiting"); stamp("No source connected")
	else
		showEmpty("Prediction Unavailable", err, "error")
		setStatus("Error"); stamp("Last try failed")
	end
end

