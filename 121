local function getOwnedMythicals()
	local ok, res = pcall(function()
		local ItemReplicationService = require(ReplicatedStorage.ItemReplicationService)
		local KEYS = require(ReplicatedStorage.ItemReplicationService.KEYS)
		local items = ItemReplicationService:GetItems(KEYS.IS_OWNED)
		local items2 = ItemReplicationService:GetItems(KEYS.QUANTITY)
		local items3 = ItemReplicationService:GetItems(KEYS.PREFERRED_MUTATION)
		local qtyMap, mutMap, list = {}, {}, {}

		if type(items2) == "table" then
			for _, v in pairs(items2) do
				if v.ItemId then qtyMap[v.ItemId] = v.Value end
			end
		end
		if type(items3) == "table" then
			for _, v in pairs(items3) do
				if v.ItemId and v.Value and v.Value ~= "" then mutMap[v.ItemId] = true end
			end
		end
		if type(items) == "table" then
			for _, item in pairs(items) do
				if item.Value == true and item.ItemId and ItemConfig then
					local ok2, cfg = pcall(function() return ItemConfig.tryGet(item.ItemId) end)
					if ok2 and type(cfg) == "table" and cfg.Display and cfg.Display.Category == "Blox Fruit" then
						local sKey = cfg.Index and cfg.Index.StorageKey
						local dName = cfg.Display.Name
						local finalName = (dName and dName ~= "" and dName) or sKey or ""
						local idType = cfg.Index and cfg.Index.IdType
						local fType = nil
						if idType == "PhysicalMoveset" then
							fType = mutMap[item.ItemId] and "Mutated Fruit" or "Blox Fruit"
						elseif idType == "Redeemable" then
							fType = "Premium"
						end
						if fType then
							table.insert(list, {
								ItemId      = item.ItemId,
								Name        = sKey or finalName,
								DisplayName = finalName,
								Type        = fType,
								Rarity      = cfg.Quality and cfg.Quality.RarityValue or 0,
								Count       = qtyMap[item.ItemId] or 1,
							})
						end
					end
				end
			end
		end
		return list
	end)
	return (ok and res) or {}
end

