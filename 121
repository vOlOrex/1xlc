local function getPrimeTool(fruitName)
	local candidates = { fruitName .. " Fruit", fruitName }
	if fruitName:find("%(") then
		local base = fruitName:match("^(.-)%s*%(") or fruitName
		table.insert(candidates, base .. "-" .. base .. " Fruit")
		table.insert(candidates, base .. " Fruit")
		table.insert(candidates, base)
	end
	for _, n in ipairs(candidates) do
		local bp = LocalPlayer:FindFirstChild("Backpack")
		local t = bp and bp:FindFirstChild(n)
		if t and t:IsA("Tool") and not t:GetAttribute("X10Fake") then return t end
		local ct = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild(n)
		if ct and ct:IsA("Tool") and not ct:GetAttribute("X10Fake") then return ct end
	end
	return nil
end

