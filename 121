	assert(mountedOn, "could not parent the ScreenGui to PlayerGui, gethui() or CoreGui")
	dbg("mounted on", mountedOn, "| touch:", tostring(IS_TOUCH), "| keyboard:", tostring(UIS.KeyboardEnabled))

	local function viewport()
		local s = gui.AbsoluteSize
		if s.X < 50 or s.Y < 50 then
			local cam = workspace.CurrentCamera
			s = cam and cam.ViewportSize or Vector2.new(800, 450)
			if s.X < 50 or s.Y < 50 then s = Vector2.new(800, 450) end
		end
		return s
	end

	local function clampPos(tweenTime)
		if not UI.Anchor then return end
		local vp = viewport()
		local s = UI.rootScale.Scale
		local w, h = W * s, (state.minimized and HEADER or H) * s
		local x, y = pos.x, pos.y
		if not pos.moved then
			x, y = (vp.X - w) / 2, (vp.Y - h) / 2
		end
		x = math.clamp(x, 4, math.max(4, vp.X - w - 4))
		y = math.clamp(y, 4, math.max(4, vp.Y - h - 4))
		pos.x, pos.y = x, y
		if tweenTime then
			tween(UI.Anchor, tweenTime, { Position = UDim2.fromOffset(x, y) })
		else
			UI.Anchor.Position = UDim2.fromOffset(x, y)
		end
	end

	local function clampOrb()
		if not UI.Orb then return end
		local vp = viewport()
		if orbPos.y == nil then orbPos.y = math.floor(vp.Y * 0.4) end
		orbPos.x = math.clamp(orbPos.x, 4, math.max(4, vp.X - 44))
		orbPos.y = math.clamp(orbPos.y, 4, math.max(4, vp.Y - 44))
		UI.Orb.Position = UDim2.fromOffset(orbPos.x, orbPos.y)
	end

