		for k, v in pairs(e.p) do if show then e.o[k] = 1; goal[k] = v else goal[k] = 1 end end
		tween(e.o, t, goal)
	end
end
local function restoreAll(list)
	for _, e in ipairs(list) do
		for k, v in pairs(e.p) do pcall(function() e.o[k] = v end) end
	end
end

